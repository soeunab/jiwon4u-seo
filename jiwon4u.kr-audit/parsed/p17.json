    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "\ud074\ub85c\ub4dc \ubb34\ub8cc\ub85c\ub3c4 \uc4f8 \uc218 \uc788\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\ub124, \ud074\ub85c\ub4dc\ub294 Free \uc694\uae08\uc81c($0)\ub85c \uc4f8 \uc218 \uc788\uc5b4\uc694. 2026\ub144 10\uc6d4 7\uc77c \uae30\uc900 \uacf5\uc2dd \ud398\uc774\uc9c0\uc5d0 \uc6f9&#183;\ub370\uc2a4\ud06c\ud1b1&#183;\ubaa8\ubc14\uc77c \ucc44\ud305, \uc6f9 \uac80\uc0c9, \ud30c\uc77c \uc0dd\uc131, \ucf54\ub4dc \uc2e4\ud589, \uba54\ubaa8\ub9ac, \uc571 \uc5f0\uacb0, \uc544\ud2f0\ud329\ud2b8\uac00 \ud3ec\ud568\ub3fc \uc788\uc5b4\uc694. \ub2e4\ub9cc \uc0ac\uc6a9\ub7c9 \ud55c\ub3c4\ub294 \uc720\ub8cc\ubcf4\ub2e4 \uc801\uc5b4\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "\ud074\ub85c\ub4dc \ud504\ub85c \uac00\uaca9\uacfc \uad6c\ub3c5\ub8cc\ub294 \uc5bc\ub9c8\uc778\uac00\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\ud074\ub85c\ub4dc Pro \uad6c\ub3c5\ub8cc\ub294 \uc6d4 $20\uc774\uace0, \uc5f0\uac04 \uacb0\uc81c\ub97c \ud558\uba74 \uc6d4 $17 \uc0c1\ub2f9\uc774\uc5d0\uc694(2026\ub144 10\uc6d4 7\uc77c \uacf5\uc2dd \uac00\uaca9 \ud398\uc774\uc9c0 \uae30\uc900, \uc138\uae08 \ubcc4\ub3c4). \ud55c\uad6d\uc5d0\uc11c \uacb0\uc81c\ud558\uba74 \ud658\uc728\uacfc \ubd80\uac00\uc138 10%\uac00 \ubd99\uc5b4 \ub300\ub7b5 \uc6d4 2.7\ub9cc~2.9\ub9cc \uc6d0\uc774\ub77c\ub294 2\ucc28 \uc790\ub8cc\uac00 \uc788\uc9c0\ub9cc, \ubcc0\ub3d9\ub418\ubbc0\ub85c \uacb0\uc81c \ud654\uba74\uc5d0\uc11c \ud655\uc778\ud558\uc138\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "\ud074\ub85c\ub4dc Max\ub294 \uc5bc\ub9c8\ubd80\ud130\uc774\uace0 Pro\uc640 \ubb50\uac00 \ub2e4\ub978\uac00\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\ud074\ub85c\ub4dc Max\ub294 \uc6d4 $100\ubd80\ud130 \uc2dc\uc791\ud558\uace0, Pro \ub300\ube44 5\ubc30 \ub610\ub294 20\ubc30 \uc0ac\uc6a9\ub7c9 \uc911\uc5d0\uc11c \uace0\ub974\ub294 \uad6c\uc870\uc608\uc694. 2\ucc28 \uc790\ub8cc \uae30\uc900\uc73c\ub85c\ub294 5\ubc30\uac00 $100, 20\ubc30\uac00 $200\uc774\uc5d0\uc694. \ucd9c\ub825 \ud55c\ub3c4\ub3c4 \ub354 \ub192\uc544\uc11c Claude Code\ub97c \uc624\ub798 \ub3cc\ub9ac\ub294 \uc0ac\ub78c\uc5d0\uac8c \ub9de\uc544\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "\ud074\ub85c\ub4dc \ud560\uc778\uc740 \ubc1b\uc744 \uc218 \uc788\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\uacf5\uc2dd \uac00\uaca9 \ud398\uc774\uc9c0\uc5d0\uc11c \ud655\uc778\ub418\ub294 \ud560\uc778\uc740 Pro\uc758 \uc5f0\uac04 \uacb0\uc81c(\uc6d4 $17 \uc0c1\ub2f9)\uc608\uc694. \uadf8 \ubc16\uc758 \ud504\ub85c\ubaa8\uc158\uc740 \uc2dc\uae30\ub9c8\ub2e4 \ub2ec\ub77c\uc11c \ud655\uc778\ud558\uc9c0 \ubabb\ud588\uc5b4\uc694. \uacb0\uc81c \ud654\uba74\uc5d0\uc11c \uc801\uc6a9 \uc5ec\ubd80\ub97c \uc9c1\uc811 \ud655\uc778\ud558\ub294 \uac8c \uc548\uc804\ud574\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "\ud074\ub85c\ub4dc \uad6c\ub3c5\uacfc API \uc694\uae08\uc740 \uac19\uc740 \uac74\uac00\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\uc544\ub2c8\uc694, \uad6c\ub3c5\uacfc API\ub294 \ubcc4\ub3c4\ub85c \uacfc\uae08\ub3fc\uc694. \uad6c\ub3c5\uc740 \uc6d4 \uc815\uc561\uc73c\ub85c claude.ai\uc640 \uc571\uc744 \uc4f0\ub294 \ubc29\uc2dd\uc774\uace0, API\ub294 \uc0ac\uc6a9\ud55c \ud1a0\ud070\ub9cc\ud07c \ub0b4\ub294 \uc885\ub7c9\uc81c\uc608\uc694. \uc571\uc5d0\uc11c \ub300\ud654\ud558\ub294 \uc6a9\ub3c4\ub77c\uba74 \uad6c\ub3c5\ub9cc \ubcf4\uba74 \ub3fc\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "\ud074\ub85c\ub4dc \uc0ac\uc6a9 \ud55c\ub3c4\ub294 \uc5b4\ub5bb\uac8c \uc801\uc6a9\ub418\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\uc720\ub8cc \ud50c\ub79c\uc740 5\uc2dc\uac04 \ub864\ub9c1 \uc138\uc158 \ud55c\ub3c4\uc640 \uc8fc\uac04 \uc0c1\ud55c\uc774 \ud568\uaed8 \uc801\uc6a9\ub3fc\uc694. \ubaa8\ub378\uacfc \uc791\uc5c5\ub7c9, \ud2b9\ud788 Claude Code \uc0ac\uc6a9\ub7c9\uc5d0 \ub530\ub77c \uc18c\uc9c4 \uc18d\ub3c4\uac00 \ub2ec\ub77c\uc694. \uc815\ud655\ud55c \uc218\uce58\ub294 \uacf5\uc2dd \uc548\ub0b4\ub97c \ud655\uc778\ud558\uc138\uc694."
          }
        }
      ]
    }
  ],
