    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "\ub85c\uceec llm \ub73b\uc744 \ud55c \uc904\ub85c \uc124\uba85\ud558\uba74 \ubb34\uc5c7\uc778\uac00\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\ub85c\uceec LLM\uc740 \ub0b4 PC\ub098 \uc11c\ubc84\uc5d0\uc11c \uc9c1\uc811 \uc2e4\ud589\ud558\ub294 \ub300\ud615 \uc5b8\uc5b4\ubaa8\ub378\uc774\uc5d0\uc694. \ud074\ub77c\uc6b0\ub4dc \uc11c\ubc84\uc5d0 \uc9c8\ubb38\uc744 \ubcf4\ub0b4\ub294 \ub300\uc2e0, \ub0b4\ub824\ubc1b\uc740 \ubaa8\ub378\uc744 \ub0b4 \ud558\ub4dc\uc6e8\uc5b4\ub85c \uacc4\uc0b0\ud574\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "\ub85c\uceecllm\uacfc \uc628\ub514\ubc14\uc774\uc2a4 AI\ub294 \uac19\uc740 \uac74\uac00\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\ube44\uc2b7\ud558\uc9c0\ub9cc \uc644\uc804\ud788 \uac19\uc9c0\ub294 \uc54a\uc544\uc694. \uc628\ub514\ubc14\uc774\uc2a4 AI\ub294 \uc2a4\ub9c8\ud2b8\ud3f0&#183;\ub178\ud2b8\ubd81 \uce69\uc5d0\uc11c \uc8fc\ub85c \uc18c\ud615 \ubaa8\ub378\uc744 \ub3cc\ub9ac\ub294 \uac1c\ub150\uc774\uace0, \ub85c\uceec LLM\uc740 PC\ub098 \uc11c\ubc84\uae4c\uc9c0 \ud3ec\ud568\ud574 \uc4f0\ub294 \uacbd\uc6b0\uac00 \ub9ce\uc544\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "\ub85c\uceec LLM\uc740 \ubb34\ub8cc\ub85c \uc4f8 \uc218 \uc788\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ollama\uc5d0\uc11c \ub0b4 \ud558\ub4dc\uc6e8\uc5b4\ub85c \ub3cc\ub9ac\ub294 \uac74 \ud50c\ub79c\uacfc \uc0c1\uad00\uc5c6\uc774 \ubb34\uc81c\ud55c \ubb34\ub8cc\uc608\uc694. \ub2e4\ub9cc \ud558\ub4dc\uc6e8\uc5b4\uc640 \uc804\uae30 \ube44\uc6a9\uc740 \uc9c1\uc811 \ubd80\ub2f4\ud558\uace0, Ollama \ud074\ub77c\uc6b0\ub4dc\ub294 \ubcc4\ub3c4 \uc694\uae08\uc774 \uc788\uc5b4\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "GPU \uc5c6\uc774\ub3c4 \ub85c\uceec LLM\uc744 \ub3cc\ub9b4 \uc218 \uc788\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\uc2e4\ud589\uc740 \uac00\ub2a5\ud574\uc694. GPU\uc5d0 \ub4e4\uc5b4\uac00\uc9c0 \uc54a\ub294 \ubd80\ubd84\uc740 CPU\uc640 \uc2dc\uc2a4\ud15c RAM\uc774 \ucc98\ub9ac\ud558\uc9c0\ub9cc \uc18d\ub3c4\ub294 \ub290\ub824\uc9c8 \uc218 \uc788\uc5b4\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "\ub85c\uceec llm \uc0ac\uc591\uc740 \uc5b4\ub5bb\uac8c \uc815\ud558\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\uace0\uc815\ub41c \ucd5c\uc18c \uc0ac\uc591\uc740 \uc5c6\uace0, \uc4f0\ub824\ub294 \ubaa8\ub378\uc758 \ud30c\uc77c \ud06c\uae30\uc5d0 \uc5ec\uc720 \uba54\ubaa8\ub9ac\ub97c \ub354\ud574 \ud310\ub2e8\ud574\uc694. \ubaa8\ub378\ubcc4 \ud06c\uae30\ub294 Ollama \ub77c\uc774\ube0c\ub7ec\ub9ac \ud398\uc774\uc9c0\uc5d0\uc11c \ud655\uc778\ud558\uc138\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "LM Studio\ub294 \uc5c5\ubb34\uc5d0\ub3c4 \ubb34\ub8cc\ub85c \uc4f8 \uc218 \uc788\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\ub0b4 PC\uc5d0\uc11c \ub85c\uceec \ubaa8\ub378\uc744 \ub3cc\ub9ac\ub294 \uac74 Free \ud50c\ub79c($0)\uc774\uace0, 2025\ub144 7\uc6d4 \uacf5\uc2dd \uc548\ub0b4 \uc774\ud6c4 \ud68c\uc0ac \uc5c5\ubb34\uc5d0\ub3c4 \ubb34\ub8cc\ub85c \uc4f8 \uc218 \uc788\uc5b4\uc694. \uc720\ub8cc \ud50c\ub79c\uc740 LM Studio \uc11c\ubc84\uc758 \ubaa8\ub378\uc744 \uc4f0\ub294 \uc694\uae08\uc774\uc5d0\uc694."
          }
        }
      ]
    }
