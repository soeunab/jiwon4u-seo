      "headline": "\ube14\ub85c\uadf8 \uc790\ub3d9\ud654 \ud504\ub85c\uadf8\ub7a8 \ub9cc\ub4e4\uae30: \ud074\ub85c\ub4dc\ub85c \ub9cc\ub4e4\uace0 Aside \ube0c\ub77c\uc6b0\uc800\ub85c \ud14c\uc2a4\ud2b8\ud558\uba70 \uc644\uc131\ud558\ub294 \uacfc\uc815",
      "description": "\ube14\ub85c\uadf8 \uc790\ub3d9\ud654 \ud504\ub85c\uadf8\ub7a8\uc740 \ucf54\ub4dc\ub97c \ubab0\ub77c\ub3c4 \ud074\ub85c\ub4dc \ucf54\ub4dc\uc5d0 CLAUDE.md\ub85c \uaddc\uce59\uc744 \uc8fc\uace0 \ub9cc\ub4e4 \uc218 \uc788\uc5b4\uc694. 2026\ub144 10\uc6d4 \uae30\uc900, Aside \ube0c\ub77c\uc6b0\uc800\ub85c \ubc84\uadf8\ub97c \uc7a1\uc740 3\ucc28 \uc2dc\ud5d8 \uae30\ub85d\uc744 \uc815\ub9ac\ud588\uc5b4\uc694.",
      "keywords": "\ube14\ub85c\uadf8 \uc790\ub3d9\ud654 \ud504\ub85c\uadf8\ub7a8, \ube14\ub85c\uadf8 \uc790\ub3d9\ud654 \ud504\ub85c\uadf8\ub7a8 \ub9cc\ub4e4\uae30, aside \ube0c\ub77c\uc6b0\uc800, \ubc14\uc774\ube0c\ucf54\ub529, \ube14\ub85c\uadf8 \uc790\ub3d9\ud654, \ud074\ub85c\ub4dc \uc790\ub3d9\ud654",
      "datePublished": "2026-10-12",
      "dateModified": "2026-10-12",
      "author": {
        "@type": "Organization",
