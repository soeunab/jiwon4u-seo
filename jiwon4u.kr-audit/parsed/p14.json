    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "\ube14\ub85c\uadf8 \uc790\ub3d9\ud654 \ud504\ub85c\uadf8\ub7a8\uc744 \ucf54\ub529 \ubaa8\ub974\ub294 \uc0ac\ub78c\ub3c4 \ub9cc\ub4e4 \uc218 \uc788\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\ub9cc\ub4e4 \uc218 \uc788\uc5b4\uc694. \uc9c0\uc6d0\ud3ec\uc720\ub294 \ucf54\ub4dc\ub97c \uac70\uc758 \ubaa8\ub974\ub294 \uc0c1\ud0dc\uc5d0\uc11c \ud074\ub85c\ub4dc \ucf54\ub4dc\uc5d0\uac8c \uc791\uc5c5\uc2dc\ucf1c '\uc9c0\uc6d0\ud3ec\uc720 \ucf58\ud150\uce20 \uc2a4\ud29c\ub514\uc624'\ub97c \ub9cc\ub4e4\uc5c8\uc5b4\uc694. \ub2e4\ub9cc \ub9cc\ub4e0 \uacb0\uacfc\ub97c \uc6d0\ubb38\uacfc \ube44\uad50\ud574 \uac80\uc99d\ud558\ub294 \uacfc\uc815\uc774 \uaf2d \ud544\uc694\ud574\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "\ube14\ub85c\uadf8 \uc790\ub3d9\ud654 \ud504\ub85c\uadf8\ub7a8\uc5d0 API \ube44\uc6a9\uc774 \ub530\ub85c \ub4dc\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\uc9c0\uc6d0\ud3ec\uc720\ub294 Claude \uad6c\ub3c5(\ud074\ub85c\ub4dc \ucf54\ub4dc \ub85c\uadf8\uc778)\uc73c\ub85c \ub3cc\ub824\uc11c \ubcc4\ub3c4 API \ube44\uc6a9 \uc5c6\uc774 \uc37c\uc5b4\uc694. \uc815\uac00 \uae30\uc900\uc73c\ub85c \uc6d0\uace0 \ubcc0\ud658 1\ud68c \uc57d $0.10, \uce74\ub4dc\ub274\uc2a4 \uae30\ud68d 1\ud68c \uc57d $0.01\uc744 \uae30\ub85d\ud588\uc5b4\uc694. \uc694\uae08\uacfc \ud55c\ub3c4\ub294 \uacf5\uc2dd \uac00\uaca9 \ud398\uc774\uc9c0\uc5d0\uc11c \ud655\uc778\ud558\uc138\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "\ud074\ub85c\ub4dc Pro \ud50c\ub79c\uc73c\ub85c\ub3c4 \ube14\ub85c\uadf8 \uc790\ub3d9\ud654 \ud504\ub85c\uadf8\ub7a8\uc744 \uac1c\ubc1c\ud560 \uc218 \uc788\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\ub9cc\ub4e4 \uc218\ub294 \uc788\uc9c0\ub9cc \uac1c\ubc1c\uacfc \ud14c\uc2a4\ud2b8\ub97c \ubc18\ubcf5\ud558\uba74 \uc0ac\uc6a9\ub7c9 \ud55c\ub3c4\uc5d0 \uc790\uc8fc \uac78\ub9b4 \uc218 \uc788\uc5b4\uc694. \uc9c0\uc6d0\ud3ec\uc720\ub294 Pro\uc5d0\uc11c 5\uc2dc\uac04 \uc138\uc158 \ud55c\ub3c4\uc640 \uc8fc\uac04 \ud55c\ub3c4\ub97c \ubaa8\ub450 \uc368\uc11c \uc791\uc5c5\uc774 \ub04a\uacbc\uace0, \uac1c\ubc1c&#183;\ud14c\uc2a4\ud2b8 \uae30\uac04 \ub3d9\uc548 Max \ud50c\ub79c\uc73c\ub85c \uc62c\ub838\uc5b4\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "CLAUDE.md\ub294 \uc9c1\uc811 \ucc98\uc74c\ubd80\ud130 \uc368\uc57c \ud558\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\uc544\ub2c8\uc694. \uacf5\uc2dd \ubb38\uc11c \uae30\uc900\uc73c\ub85c \ud074\ub85c\ub4dc \ucf54\ub4dc\uc5d0\uc11c /init \uc744 \uc2e4\ud589\ud558\uba74 \uc2dc\uc791\uc6a9 CLAUDE.md\ub97c \ub9cc\ub4e4\uc5b4 \uc918\uc694. \uadf8 \ub4a4 \ud074\ub85c\ub4dc\uac00 \uac19\uc740 \uc2e4\uc218\ub97c \ubc18\ubcf5\ud558\uac70\ub098 \uac19\uc740 \uc124\uba85\uc744 \ub2e4\uc2dc \ud558\uac8c \ub420 \ub54c \uaddc\uce59\uc744 \ub367\ubd99\uc774\uba74 \ub3fc\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "CLAUDE.md\ub294 \ubb34\uc5c7\uc774\uace0 \uc65c \ud544\uc694\ud55c\uac00\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "CLAUDE.md\ub294 \ud504\ub85c\uc81d\ud2b8 \ub8e8\ud2b8\uc5d0 \ub450\ub294 \ub9c8\ud06c\ub2e4\uc6b4 \ud30c\uc77c\ub85c \ub9e4 \uc138\uc158 \uc2dc\uc791 \ub54c \uc77d\ud600\uc694. \uad6c\uc870\uc640 \uc9c0\ucf1c\uc57c \ud560 \uaddc\uce59\uc744 \uc801\uc5b4 \ub450\uba74 \uc791\uc5c5\ud560 \ub54c\ub9c8\ub2e4 \ub2e4\uc2dc \uc124\uba85\ud558\uc9c0 \uc54a\uc544\ub3c4 \ub3fc\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "Aside \ube0c\ub77c\uc6b0\uc800\ub294 \uc790\ub3d9\ud654 \ud504\ub85c\uadf8\ub7a8\uc744 \ub9cc\ub4e4 \ub54c \uc5b4\ub5bb\uac8c \uc4f0\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\uc2a4\ud29c\ub514\uc624 \ud654\uba74\uc744 \uc2e4\uc81c\ub85c \ub20c\ub7ec \ubcf4\uba70 \uc2dc\ud5d8\ud558\uace0, \ub9cc\ub4e4\uc5b4\uc9c4 HTML\uc744 \ube14\ub85c\uadf8 \uc6d0\ubb38\uacfc \ud55c \uc904\uc529 \ube44\uad50\ud558\ub294 \ub370 \uc37c\uc5b4\uc694. \ubc84\uadf8\ub97c \ucc3e\uc73c\uba74 \ucf54\ub4dc\ub97c \uace0\uce58\uace0 \uc6cc\ucee4\ub97c \uc7ac\uc2dc\uc791\ud55c \ub4a4 \uac19\uc740 \uc2dc\ud5d8\uc744 \ubc18\ubcf5\ud588\uc5b4\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "\ucf54\ub4dc\ub97c \uace0\ucce4\ub294\ub370 \uacb0\uacfc\uac00 \uadf8\ub300\ub85c\uc778 \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\uc6cc\ucee4\ub97c \uc7ac\uc2dc\uc791\ud558\uc9c0 \uc54a\uc73c\uba74 \uc608\uc804 \ucf54\ub4dc\ub85c \uacc4\uc18d \ub3cc \uc218 \uc788\uc5b4\uc694. \uc9c0\uc6d0\ud3ec\uc720\ub3c4 \uc2e4\uc81c\ub85c \ud55c \ubc88 \uacaa\uc5c8\uc5b4\uc694. \uc218\uc815 \ub4a4\uc5d0\ub294 \uc6cc\ucee4\ub97c \uc7ac\uc2dc\uc791\ud558\uace0 \uac19\uc740 \uc2dc\ud5d8\uc744 \ub2e4\uc2dc \ub3cc\ub824 \ubcf4\uc138\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "\ub9cc\ub4e0 \ud504\ub85c\uadf8\ub7a8\uc744 \ub2e4\ub978 \uc0ac\ub78c\uc5d0\uac8c \ud310\ub9e4\ud558\uac70\ub098 \ubc30\ud3ec\ud574\ub3c4 \ub418\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\uacf5\uc2dd \uc57d\uad00\uc740 \uc81c\ud488&#183;\uc11c\ube44\uc2a4\ub97c \ub9cc\ub4dc\ub294 \uac1c\ubc1c\uc790\uc5d0\uac8c API \ud0a4 \uc778\uc99d\uc744 \uc4f0\ub3c4\ub85d \uc548\ub0b4\ud558\uace0, \ub2e4\ub978 \uc0ac\ub78c \ub300\uc2e0 \uad6c\ub3c5 \uc778\uc99d\uc73c\ub85c \uc694\uccad\uc744 \uc911\uacc4\ud558\ub294 \uac83\uc744 \uae08\uc9c0\ud574\uc694. \ubc30\ud3ec&#183;\ud310\ub9e4 \uc804\uc5d0 \ucd5c\uc2e0 \uc57d\uad00\uc744 \uaf2d \ud655\uc778\ud558\uc138\uc694."
          }
        }
      ]
    }
