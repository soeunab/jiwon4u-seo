    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "\ud074\ub85c\ub4dc MCP\ub294 \uc5b4\ub514\uc11c \uc5f0\uacb0\ud558\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "claude.ai\uc758 \uc0ac\uc6a9\uc790 \uc9c0\uc815 > \ucee4\ub125\ud130\uc5d0\uc11c \uc5f0\uacb0\ud574\uc694. \ubaa9\ub85d\uc5d0\uc11c \uace0\ub974\uac70\ub098 \ucee4\uc2a4\ud140 \ucee4\ub125\ud130\ub85c \uc11c\ubc84 URL\uc744 \ub123\uc73c\uba74 \ub429\ub2c8\ub2e4. \uc5f0\uacb0\ud55c \ucee4\ub125\ud130\ub294 \ucc44\ud305\ucc3d \uc67c\ucabd \uc544\ub798 '+' > \ucee4\ub125\ud130\uc5d0\uc11c \ub300\ud654\ub9c8\ub2e4 \ucf1c\uace0 \ub04c \uc218 \uc788\uc5b4\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "\ud074\ub85c\ub4dc MCP \ucee4\uc2a4\ud140 \ucee4\ub125\ud130\ub294 \ubb34\ub8cc\ub85c \uc4f8 \uc218 \uc788\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\ub124, Free \uc694\uae08\uc81c\uc5d0\uc11c\ub3c4 \uc4f8 \uc218 \uc788\uc9c0\ub9cc \ucee4\uc2a4\ud140 \ucee4\ub125\ud130\ub294 1\uac1c\uae4c\uc9c0\uc608\uc694. Pro&#183;Max&#183;Team&#183;Enterprise\ub3c4 \uac00\ub2a5\ud558\uace0, Team&#183;Enterprise\ub294 \uc18c\uc720\uc790\uac00 \uc870\uc9c1\uc5d0 \uba3c\uc800 \ucd94\uac00\ud574\uc57c \ud574\uc694. \uc774 \uc870\uac74\uc740 Claude \uace0\uac1d\uc9c0\uc6d0 \ubb38\uc11c\uc758 \ucee4\uc2a4\ud140 \ucee4\ub125\ud130 \uc548\ub0b4\uc5d0 \ub098\uc640 \uc788\uc5b4\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "\ud074\ub85c\ub4dc\uac00 \ub178\uc158 \ud398\uc774\uc9c0\ub97c \ub9c8\uc74c\ub300\ub85c \uace0\uce58\uc9c0\ub294 \uc54a\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\ub3c4\uad6c \uad8c\ud55c\uc744 \uc2b9\uc778 \ud544\uc694\ub85c \ub450\uba74 \uc2e4\ud589 \uc804\uc5d0 \ud655\uc778\uc744 \ubc1b\uc544\uc694. \uc77d\uae30\ub9cc \uc2dc\ud0a4\uace0 \uc2f6\ub2e4\uba74 \ud504\ub86c\ud504\ud2b8\uc5d0 '\uace0\uce58\uc9c0 \ub9d0\uace0 \uc77d\uae30\ub9cc \ud574 \uc918'\ub77c\uace0 \uc801\ub294 \ubc29\ubc95\ub3c4 \uc788\uc5b4\uc694. \uc4f0\uae30 \ub3c4\uad6c\ub294 \uc2b9\uc778 \ud544\uc694\ub098 \ucc28\ub2e8\uc73c\ub85c \ub450\ub294 \uac78 \uad8c\ud574\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "claude mcp \uc11c\ubc84 \uc8fc\uc18c\ub294 \uc5b4\ub5a4 \ud615\uc2dd\uc73c\ub85c \ub123\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\uc11c\ubc84\uac00 MCP \uc694\uccad\uc744 \ubc1b\ub294 HTTPS \uc8fc\uc18c\ub97c \ub123\uc5b4\uc694. \ucd94\uac00 \ucc3d\uc758 \uc608\uc2dc\ub294 https://mcp.example.com/mcp \ud615\ud0dc\uc608\uc694. \ub178\uc158 \ucee4\ub125\ud130 \uc0c1\uc138 \ud654\uba74\uc5d0\ub294 https://mcp.notion.com/mcp\uac00 \ud45c\uc2dc\ub410\uc5b4\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "\ub0b4 \ucef4\ud4e8\ud130\uc5d0\uc11c\ub9cc \ub3c4\ub294 \ub85c\uceec MCP \uc11c\ubc84\ub3c4 claude.ai\uc5d0 \uc5f0\uacb0\ub418\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\uc5f0\uacb0\ub418\uc9c0 \uc54a\uc544\uc694. claude_desktop_config.json\uc5d0 \uc801\ub294 \ub85c\uceec MCP \uc11c\ubc84\ub294 Cowork\uc640 claude.ai\uc5d0\uc11c \uc4f8 \uc218 \uc5c6\uc5b4\uc694. \ucee4\uc2a4\ud140 \ucee4\ub125\ud130\ub294 Anthropic \ud074\ub77c\uc6b0\ub4dc\uc5d0\uc11c \uc811\uc18d\ud558\ubbc0\ub85c \uacf5\uac1c \uc778\ud130\ub137\uc5d0\uc11c \uc811\uadfc \uac00\ub2a5\ud55c \uc6d0\uaca9 \uc11c\ubc84\uc5ec\uc57c \ud574\uc694."
          }
        }
      ]
