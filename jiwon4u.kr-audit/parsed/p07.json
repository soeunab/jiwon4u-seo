    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "\ud074\ub85c\ub4dc \uc774\ubbf8\uc9c0 \uc0dd\uc131 \uac00\ub2a5\ud55c\uac00\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\uc0ac\uc9c4\uc774\ub098 \uc77c\ub7ec\uc2a4\ud2b8\ub97c \uadf8\ub9ac\ub294 \uc774\ubbf8\uc9c0 \uc0dd\uc131\uc740 \ud558\uc9c0 \uc54a\uc544\uc694. \ub300\uc2e0 SVG&#183;HTML&#183;CSS \ucf54\ub4dc\ub85c \ub3c4\ud45c, \ucc28\ud2b8, \uc378\ub124\uc77c, \ubaa8\uc158\uadf8\ub798\ud53d \uac19\uc740 \uc2dc\uac01 \uc790\ub8cc\ub97c \ub9cc\ub4e4\uc5b4\uc694. \uc62c\ub9b0 \uc774\ubbf8\uc9c0\ub97c \ubcf4\uace0 \ubd84\uc11d\ud558\ub294 \uac83\uc740 \uac00\ub2a5\ud574\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "\ud074\ub85c\ub4dc SVG\ub294 \uc5b4\ub5bb\uac8c \uc4f0\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\ud750\ub984\ub3c4\ub098 \uc544\uc774\ucf58\uc744 'SVG\ub85c \uadf8\ub824 \uc918'\ub77c\uace0 \uc694\uccad\ud558\uba74 SVG \ud30c\uc77c\ub85c \ubc1b\uc744 \uc218 \uc788\uc5b4\uc694. \uae00\uc790\ub97c \ubc14\uafb8\ub824\uba74 \ud30c\uc77c \uc548\uc758 \uae00\uc790\ub9cc \uace0\uce58\uba74 \ub418\uace0, \ube14\ub85c\uadf8\uc5d0 \uc62c\ub9b4 \ub54c\ub294 PNG\ub85c \ubc14\uafd4 \uc4f0\ub294 \uac8c \ud3b8\ud574\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "\ud074\ub85c\ub4dc \uc774\ubbf8\uc9c0 \uc0dd\uc131 \uae30\ub2a5\uc740 \ubaa8\ubc14\uc77c \uc571\uc5d0\uc11c\ub3c4 \ub418\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\ucee4\uc2a4\ud140 \uc2dc\uac01 \uc790\ub8cc\ub294 \uc6f9\uacfc \ub370\uc2a4\ud06c\ud0d1\uc5d0\uc11c \ubca0\ud0c0\ub85c \uc81c\uacf5\ub3fc\uc694. iOS&#183;Android \uc571\uc5d0\uc11c\ub294 \ubcf4\uc774\uc9c0 \uc54a\uc544\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "\ud074\ub85c\ub4dc\uac00 \ub9cc\ub4e0 \uc2dc\uac01 \uc790\ub8cc\ub294 \uc800\uc7a5\ub418\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\uae30\ubcf8\uc73c\ub85c\ub294 \uc800\uc7a5\ub418\uc9c0 \uc54a\ub294 \uc784\uc2dc \uadf8\ub9bc\uc774\uc5d0\uc694. \uc774\ubbf8\uc9c0\ub85c \ubcf5\uc0ac\ud558\uac70\ub098 .svg \ub610\ub294 .html\ub85c \ub2e4\uc6b4\ub85c\ub4dc\ud558\uac70\ub098 \uc544\ud2f0\ud329\ud2b8\ub85c \uc800\uc7a5\ud558\uba74 \ub0a8\uae38 \uc218 \uc788\uc5b4\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "\ud074\ub85c\ub4dc \uc774\ubbf8\uc9c0 \uc0dd\uc131 \ud504\ub86c\ud504\ud2b8\ub294 \uc5b4\ub5bb\uac8c \uc4f0\uba74 \uc88b\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\ud06c\uae30, \uc0c9, \uae00\uc790 \uc5b8\uc5b4, \ub123\uc744 \ubb38\uad6c\ub97c \uc694\uccad \ubb38\uc7a5\uc5d0 \uad6c\uccb4\uc801\uc73c\ub85c \uc801\uc73c\uba74 \uc88b\uc544\uc694. \ucca8\ubd80\ud55c \uadf8\ub9bc\uc744 \uc4f8 \ub54c\ub294 '\ub2e4\uc2dc \uadf8\ub9ac\uc9c0 \ub9d0\uace0 \uadf8\ub300\ub85c \uc368 \uc918'\ub97c \ub367\ubd99\uc774\uba74 \uc6d0\ubcf8\uc774 \uc720\uc9c0\ub3fc\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "\ubb34\ub8cc \ud50c\ub79c\uc5d0\uc11c\ub3c4 \ucf54\ub4dc\ub85c \uadf8\ub9bc\uc744 \ub9cc\ub4e4 \uc218 \uc788\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\uc544\ud2f0\ud329\ud2b8\ub294 Free\ub97c \ud3ec\ud568\ud55c \ubaa8\ub4e0 \ud50c\ub79c\uc5d0\uc11c \uc4f8 \uc218 \uc788\uc5b4\uc694. \ub2e4\ub9cc Claude Motion \ud15c\ud50c\ub9bf\uc740 Team&#183;Enterprise \uc804\uc6a9\uc774\uace0, \uc694\uae08\uc740 \ubc14\ub014 \uc218 \uc788\uc73c\ub2c8 \uacf5\uc2dd \ud398\uc774\uc9c0\uc5d0\uc11c \ud655\uc778\ud558\uc138\uc694."
          }
        }
      ]
    }
  ],
