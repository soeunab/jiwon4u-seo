    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "\ud074\ub85c\ub4dc \uc2a4\ud0ac \ub9cc\ub4dc\ub294 \ubc95 \uc911 \ucd08\ubcf4\uc790\uc5d0\uac8c \ub9de\ub294 \uac74 \ubb34\uc5c7\uc778\uac00\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "'Claude\ub85c \ub9cc\ub4e4\uae30'\uac00 \uac00\uc7a5 \uc26c\uc6cc\uc694. skill-creator\uc640 \ub300\ud654\ud558\uba70 \ucd08\uc548\uc744 \ubc1b\uace0 \ud14c\uc2a4\ud2b8\uae4c\uc9c0 \ud55c \ub4a4 \uc800\uc7a5\ud560 \uc218 \uc788\uc5b4\uc11c SKILL.md \ud615\uc2dd\uc744 \ubab0\ub77c\ub3c4 \ub3fc\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "\ud074\ub85c\ub4dc \uc2a4\ud0ac \ucd94\uac00 \ubc84\ud2bc\uc740 \uc5b4\ub514\uc5d0 \uc788\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\uc0ac\uc6a9\uc790 \uc9c0\uc815 > Skills\uc758 \ub0b4 \ud56d\ubaa9 \uc624\ub978\ucabd \uc704\uc5d0 '\ucd94\uac00'\uac00 \uc788\uc5b4\uc694. \ub204\ub974\uba74 Skill \uc5c5\ub85c\ub4dc, Skill \ub9cc\ub4e4\uae30, Claude\ub85c \ub9cc\ub4e4\uae30\uac00 \ub098\uc640\uc694. \uacc4\uc815\uc774\ub098 \uc571 \ubc84\uc804\uc5d0 \ub530\ub77c \uad6c\uc131\uc740 \ub2e4\ub97c \uc218 \uc788\uc5b4\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "\ud074\ub85c\ub4dc \uc2a4\ud0ac\uc774 \uc791\ub3d9\ud558\uc9c0 \uc54a\uc73c\uba74 \uc5b4\ub5bb\uac8c \ud558\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\uba3c\uc800 \ucf54\ub4dc \uc2e4\ud589(Code execution and file creation)\uc774 \ucf1c\uc838 \uc788\ub294\uc9c0 \ud655\uc778\ud558\uc138\uc694. \uadf8\ub2e4\uc74c Skills\uc5d0\uc11c \ud574\ub2f9 \uc2a4\ud0ac\uc774 \ucf1c\uc838 \uc788\ub294\uc9c0 \ubcf4\uace0, \uadf8\ub798\ub3c4 \uc548 \ubd88\ub9ac\uba74 description\uc5d0 \uc5b8\uc81c \uc4f0\ub294\uc9c0 \ub354 \uad6c\uccb4\uc801\uc73c\ub85c \uc801\uc5b4\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "SKILL.md\uc758 name\uacfc description\uc5d0\ub294 \uae00\uc790 \uc218 \uc81c\ud55c\uc774 \uc788\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\uacf5\uc2dd \ub3c4\uc6c0\ub9d0\uc5d0 \ub530\ub974\uba74 name\uc740 64\uc790 \uc774\ub0b4, description\uc740 200\uc790 \uc774\ub0b4\uc774\uace0 \ub458 \ub2e4 \ud544\uc218\uc608\uc694. description\uc740 Claude\uac00 \uc2a4\ud0ac\uc744 \uc4f8\uc9c0 \ud310\ub2e8\ud558\ub294 \uadfc\uac70\uc608\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "\ub0b4\uac00 \ub9cc\ub4e0 \uc2a4\ud0ac\uc744 \ub3d9\ub8cc\ub3c4 \ubcfc \uc218 \uc788\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\uacf5\uc2dd \ub3c4\uc6c0\ub9d0\uc5d0 \ub530\ub974\uba74 \uc9c1\uc811 \uc62c\ub9b0 \uc2a4\ud0ac\uc740 \uacf5\uc720\ud558\uae30 \uc804\uae4c\uc9c0 \ub3d9\ub8cc\uc5d0\uac8c \ubcf4\uc774\uc9c0 \uc54a\uc544\uc694."
          }
        }
      ]
