    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "\uce74\ub4dc\ub274\uc2a4 \ub9cc\ub4e4\uae30 AI\ub294 \ubb34\ub8cc\ub85c \ud560 \uc218 \uc788\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Claude\uc758 \ubb34\ub8cc \uc694\uae08\uc81c \ud55c\ub3c4\uc640 \uc81c\uacf5 \uae30\ub2a5\uc740 \uc694\uae08 \ud398\uc774\uc9c0\uc5d0\uc11c \ud655\uc778\ud574\uc57c \ud574\uc694. \uc9c0\uc6d0\ud3ec\uc720\ub294 \uad6c\ub3c5 \ud658\uacbd\uc5d0\uc11c \ucd94\uac00 \uacb0\uc81c \uc5c6\uc774 \uc37c\uace0, \uc815\uac00 \uae30\uc900\uc73c\ub85c\ub294 \uae30\ud68d 1\ud68c\uac00 \uc57d $0.01\uc774\uc5c8\uc5b4\uc694. \uc694\uae08\uc740 \ubc14\ub014 \uc218 \uc788\uc73c\ub2c8 claude.com/pricing\uc744 \ud655\uc778\ud558\uc138\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "\uce74\ub4dc\ub274\uc2a4 \uc0ac\uc774\uc988\ub294 \uc5b4\ub5bb\uac8c \uc815\ud558\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\uc9c0\uc6d0\ud3ec\uc720\ub294 1080&#215;1350(\uc138\ub85c 4:5)\uc73c\ub85c \ub9cc\ub4e4\uc5c8\uc5b4\uc694. \uac8c\uc2dc\ud560 \ub54c\ub3c4 \uc138\ub85c 4:5\ub97c \uace0\ub974\ub2c8 \uce74\ub4dc\uac00 \uc798\ub9ac\uc9c0 \uc54a\uc558\uc5b4\uc694. \uc778\uc2a4\ud0c0\uadf8\ub7a8 API \ubb38\uc11c\uc5d0\ub294 \uce90\ub7ec\uc140\uc774 \uccab \uc774\ubbf8\uc9c0 \ube44\uc728\uc744 \ub530\ub978\ub2e4\uace0 \ub098\uc640 \uc788\uc5b4\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "\uc778\uc2a4\ud0c0\uadf8\ub7a8 \uce74\ub4dc\ub274\uc2a4 \uc774\ubbf8\uc9c0\ub294 PNG\ub85c \uc62c\ub824\ub3c4 \ub418\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "API\ub85c \uc62c\ub9b0\ub2e4\uba74 JPEG\ub97c \uc4f0\ub294 \uac8c \uc548\uc804\ud574\uc694. Meta \uac1c\ubc1c\uc790 \ubb38\uc11c\ub294 \uac8c\uc2dc API\uac00 JPEG\ub9cc \uc9c0\uc6d0\ud55c\ub2e4\uace0 \uc548\ub0b4\ud574\uc694. \uadf8\ub798\uc11c \ucc98\uc74c PNG\uc600\ub358 \uc800\uc7a5 \ud615\uc2dd\uc744 JPEG\ub85c \ubc14\uafe8\uc5b4\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "\uce74\ub4dc\ub274\uc2a4\ub294 \uba87 \uc7a5\uc73c\ub85c \ub9cc\ub4e4\uba74 \ub418\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\uc9c0\uc6d0\ud3ec\uc720\ub294 7\uc7a5\uc73c\ub85c \ub9cc\ub4e4\uc5c8\uc5b4\uc694. \uc778\uc2a4\ud0c0\uadf8\ub7a8 \uc571&#183;\uc6f9\uc5d0\uc11c \uc9c1\uc811 \uc62c\ub9ac\uba74 \ud55c \uac8c\uc2dc\ubb3c\uc5d0 \ucd5c\ub300 20\uc7a5\uae4c\uc9c0 \uc62c\ub9b4 \uc218 \uc788\uace0(\uacf5\uc2dd \ub3c4\uc6c0\ub9d0), \uac8c\uc2dc API\ub85c \uc62c\ub9ac\ub294 \uce90\ub7ec\uc140\uc740 \ucd5c\ub300 10\uac1c\uc608\uc694(Meta \uac1c\ubc1c\uc790 \ubb38\uc11c)."
          }
        },
        {
          "@type": "Question",
          "name": "\uc2a4\ub808\ub4dc\uc640 \uc778\uc2a4\ud0c0\uadf8\ub7a8 \ucea1\uc158\uc740 \uac19\uac8c \uc368\ub3c4 \ub418\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\uc5ed\ud560\uc744 \ub098\ub204\ub294 \ud3b8\uc774 \uc88b\uc558\uc5b4\uc694. \uc778\uc2a4\ud0c0\uadf8\ub7a8\uc740 \uc800\uc7a5\ud558\ub294 \uc694\uc57d\ud615\uc73c\ub85c, \uc2a4\ub808\ub4dc\ub294 \ubc18\ub9d0 \ub300\ud654\ud615\uc73c\ub85c \uc4f0\uace0 \ub9c1\ud06c\ub294 \ubcf8\uc778 \ub2f5\uae00\uc5d0 \ub2ec\uc558\uc5b4\uc694."
          }
        }
      ]
    }
  ],
