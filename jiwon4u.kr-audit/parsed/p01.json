    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "\ud074\ub85c\ub4dc \uc544\ud2f0\ud329\ud2b8 \ub73b\uc774 \ubb54\uac00\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\ud074\ub85c\ub4dc \uc544\ud2f0\ud329\ud2b8\ub294 Claude\uac00 \ub300\ud654 \uc606 \ud328\ub110\uc5d0 \ub9cc\ub4e4\uc5b4 \uc8fc\ub294 \ub3c5\ub9bd \uacb0\uacfc\ubb3c\uc774\uc5d0\uc694. \ubb38\uc11c, \uc2ac\ub77c\uc774\ub4dc, \ub514\uc790\uc778, \ub300\uc2dc\ubcf4\ub4dc, \uc791\uc740 \ub300\ud654\ud615 \ub3c4\uad6c \ub4f1\uc774 \ud574\ub2f9\ud558\uace0 \ud3b8\uc9d1\uacfc \uc7ac\ubc29\ubb38, \uacf5\uc720\uac00 \uac00\ub2a5\ud574\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "\ud074\ub85c\ub4dc \uc544\ud2f0\ud329\ud2b8\ub294 \ubb34\ub8cc\ub85c \uc4f8 \uc218 \uc788\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\ub124, Free \ud50c\ub79c\uc5d0\uc11c\ub3c4 \uc544\ud2f0\ud329\ud2b8\ub97c \ub9cc\ub4e4 \uc218 \uc788\uace0 Docs&#183;Slides&#183;Design \ud15c\ud50c\ub9bf\ub3c4 \uc804 \ud50c\ub79c\uc5d0\uc11c \uc81c\uacf5\ub3fc\uc694. Dashboards(\ubca0\ud0c0)\ub294 Pro&#183;Max&#183;Team&#183;Enterprise, Motion(\ubca0\ud0c0)\uc740 Team&#183;Enterprise\uc5d0\uc11c\ub9cc \uc4f8 \uc218 \uc788\uc5b4\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "\ud074\ub85c\ub4dc \uc544\ud2f0\ud329\ud2b8 \uacf5\uc720\ub294 \uc5b4\ub5bb\uac8c \ud558\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\uc6f9\uc774\ub098 Claude Desktop\uc5d0\uc11c \uacf5\uc720 \uc124\uc815\uc744 \ubc14\uafd4\uc694. \uae30\ubcf8\uc740 \ube44\uacf5\uac1c\uc774\uace0, Pro&#183;Max&#183;Team&#183;Enterprise\uc5d0\uc11c \ub9c1\ud06c \uacf5\uc720\uac00 \uac00\ub2a5\ud574\uc694(Team&#183;Enterprise\ub294 \uc18c\uc720\uc790\uac00 \uc678\ubd80 \uacf5\uc720\ub97c \ud5c8\uc6a9\ud574\uc57c \ud574\uc694). \uc774\uba54\uc77c \ucd08\ub300(\ubca0\ud0c0)\ub294 Pro&#183;Max&#183;Team&#183;Enterprise\uc5d0\uc11c \uc4f8 \uc218 \uc788\uc5b4\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "\ud074\ub85c\ub4dc \uc544\ud2f0\ud329\ud2b8 \uc800\uc7a5 \uc6a9\ub7c9 \ud55c\ub3c4\uac00 \uc788\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Pro \uc774\uc0c1 \ud50c\ub79c\uc5d0\uc11c \uc544\ud2f0\ud329\ud2b8 \uc548\uc5d0 \ub370\uc774\ud130\ub97c \uc800\uc7a5\ud560 \uc218 \uc788\uace0, \uc544\ud2f0\ud329\ud2b8\ub2f9 20MB\uae4c\uc9c0 \ud14d\uc2a4\ud2b8\ub9cc \uac00\ub2a5\ud574\uc694. \uc774\ubbf8\uc9c0, \ud30c\uc77c, \ubc14\uc774\ub108\ub9ac\ub294 \uc800\uc7a5\ub418\uc9c0 \uc54a\uc544\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "\ud074\ub85c\ub4dc \uc544\ud2f0\ud329\ud2b8 \uc0ad\uc81c\ub098 \uac8c\uc2dc \ucde8\uc18c\ud558\uba74 \ubcf5\uad6c\ub418\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\uac8c\uc2dc\ub41c \ub808\uac70\uc2dc \ucc44\ud305 \uc544\ud2f0\ud329\ud2b8\uc758 \uac8c\uc2dc\ub97c \ucde8\uc18c\ud558\uba74 \ub2e4\uc2dc \uac8c\uc2dc\ud560 \uc218 \uc5c6\uace0, \uc0ac\uc6a9\ud55c \uc800\uc7a5 \ub370\uc774\ud130\ub3c4 \uc601\uad6c \uc0ad\uc81c\ub3fc\uc694. \ud544\uc694\ud558\uba74 \uba3c\uc800 Word\ub098 PDF \ub4f1\uc73c\ub85c \ub0b4\ubcf4\ub0b4 \ub450\uc138\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "\uacf5\uc720 \uc124\uc815\uc744 \ubaa8\ubc14\uc77c\uc5d0\uc11c \ubc14\uafc0 \uc218 \uc788\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\uc544\ub2c8\uc694, iOS\uc640 Android \uc571\uc5d0\uc11c\ub294 \uacf5\uc720 \uc124\uc815\uc744 \ubc14\uafc0 \uc218 \uc5c6\uc5b4\uc694. \uc6f9\uc774\ub098 Claude Desktop\uc5d0\uc11c \ubcc0\uacbd\ud574\uc57c \ud574\uc694."
          }
        }
      ]
    }
  ],
