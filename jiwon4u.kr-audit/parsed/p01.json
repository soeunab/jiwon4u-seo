      "description": "\ud074\ub85c\ub4dc \uc544\ud2f0\ud329\ud2b8 \ub73b\uacfc \uc0ac\uc6a9\ubc95, \ubb34\ub8cc \ud50c\ub79c \ubc94\uc704, \uacf5\uc720&#183;\ub0b4\ubcf4\ub0b4\uae30 \ubc29\ubc95\uc744 \uc815\ub9ac\ud588\uc5b4\uc694.",
      "keywords": "\ud074\ub85c\ub4dc \uc544\ud2f0\ud329\ud2b8, \ud074\ub85c\ub4dc \uc544\ud2f0\ud329\ud2b8 \ub73b, \ud074\ub85c\ub4dc \uc544\ud2f0\ud329\ud2b8 \uc0ac\uc6a9\ubc95, \ud074\ub85c\ub4dc \uc544\ud2f0\ud329\ud2b8 \uacf5\uc720, \ud074\ub85c\ub4dc \uc544\ud2f0\ud329\ud2b8 \uc800\uc7a5, \ud074\ub85c\ub4dc \uc544\ud2f0\ud329\ud2b8 \uc0ad\uc81c, \ud074\ub85c\ub4dc \uc544\ud2f0\ud329\ud2b8 \ud65c\uc6a9\ubc29\ubc95, \ud074\ub85c\ub4dc \uc544\ud2f0\ud329\ud2b8 \uac8c\uc2dc",
      "datePublished": "2026-10-17",
