      "headline": "\ud074\ub85c\ub4dc \uc5d1\uc140 \uc0ac\uc6a9\ubc95: \ud30c\uc77c \uc62c\ub824 \ud45c \uc815\ub9ac&#183;\uc218\uc2dd&#183;\ucc28\ud2b8\uae4c\uc9c0 \ubc1b\ub294 \ubc29\ubc95",
      "description": "\ud074\ub85c\ub4dc \uc5d1\uc140 \uc0ac\uc6a9\ubc95, \uc815\ub9ac \uc548 \ub41c \ud30c\uc77c\uc744 \uc62c\ub824 \uc815\ub9ac \uc2dc\ud2b8&#183;SUMIF \ud569\uacc4&#183;\ucc28\ud2b8\ub97c \ubc1b\uace0 \uac80\uc0b0\ud558\ub294 \uc21c\uc11c \uc815\ub9ac.",
      "keywords": "\ud074\ub85c\ub4dc \uc5d1\uc140 \uc0ac\uc6a9\ubc95, \ud074\ub85c\ub4dc \uc5d1\uc140 \uc5c5\ub85c\ub4dc, \ud074\ub85c\ub4dc \uc5d1\uc140 \ubd84\uc11d, \ud074\ub85c\ub4dc \uc5d1\uc140 \ud50c\ub7ec\uadf8\uc778, \ud074\ub85c\ub4dc \uc5d1\uc140 \uc5f0\ub3d9, \ud074\ub85c\ub4dc \uc5d1\uc140 \uc790\ub3d9\ud654",
      "datePublished": "2026-10-14",
      "dateModified": "2026-10-14",
      "author": {
        "@type": "Organization",
        "name": "\uc9c0\uc6d0\ud3ec\uc720"
      },
      "publisher": {
        "@type": "Organization",
