      },
      "image": "https://storage.googleapis.com/jiwon4u-blog-images/posts%2F1791941810163-74ba5f73.png"
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "\ud074\ub85c\ub4dc \uc5d1\uc140 \uc0ac\uc6a9\ubc95\uc740 \ubb34\ub8cc\ub85c\ub3c4 \ub418\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\ub124, \ub300\ud654\ucc3d\uc5d0\uc11c \uc5d1\uc140 \ud30c\uc77c\uc744 \uc62c\ub9ac\uace0 \uc0c8 .xlsx\ub97c \ubc1b\ub294 \ubc29\ubc95\uc740 Free\ub97c \ud3ec\ud568\ud55c \ubaa8\ub4e0 \ud50c\ub79c\uc5d0\uc11c \uc4f8 \uc218 \uc788\uc5b4\uc694. \ub2e4\ub9cc \ud30c\uc77c \ub9cc\ub4e4\uae30\ub294 \uc77c\ubc18 \ub300\ud654\ubcf4\ub2e4 \uc0ac\uc6a9\ub7c9\uc744 \ub354 \uc368\uc11c \ud55c\ub3c4\uc5d0 \ub354 \ube68\ub9ac \ub2ff\uc744 \uc218 \uc788\uc5b4\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "\ud074\ub85c\ub4dc\uc5d0 \uc62c\ub9b4 \uc218 \uc788\ub294 \uc5d1\uc140 \ud30c\uc77c \ud06c\uae30 \uc81c\ud55c\uc740 \uc5bc\ub9c8\uc778\uac00\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\uc5c5\ub85c\ub4dc\uc640 \ub2e4\uc6b4\ub85c\ub4dc \ubaa8\ub450 \ud30c\uc77c \ud558\ub098\ub2f9 \ucd5c\ub300 30MB\uc608\uc694. \uc774\ubcf4\ub2e4 \ud06c\uba74 \uc2dc\ud2b8\ub97c \ub098\ub204\uac70\ub098 \ud544\uc694\ud55c \uc5f4\ub9cc \ub0a8\uae34 \ubcf5\uc0ac\ubcf8\uc744 \uc62c\ub9ac\ub294 \uac8c \uc88b\uc544\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "\ud074\ub85c\ub4dc \uc5d1\uc140 \ud50c\ub7ec\uadf8\uc778(\ucd94\uac00 \uae30\ub2a5)\uc740 \ubb34\ub8cc \ud50c\ub79c\uc5d0\uc11c\ub3c4 \uc4f8 \uc218 \uc788\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\uc544\ub2c8\uc694, Claude for Excel\uc740 Pro&#183;Max&#183;Team&#183;Enterprise \uc720\ub8cc \ud50c\ub79c\uc5d0\uc11c \uc4f8 \uc218 \uc788\uace0 Free\ub294 \ub300\uc0c1\uc774 \uc544\ub2c8\uc5d0\uc694. Excel \uc6f9, Windows\uc6a9 Microsoft 365 Excel, Mac\uc6a9 Excel\uc5d0\uc11c \uc9c0\uc6d0\ub418\uace0 Excel 2016&#183;2019\ub098 iPad, Android\ub294 \uc9c0\uc6d0\ud558\uc9c0 \uc54a\uc544\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "\ud074\ub85c\ub4dc\uac00 \ub9cc\ub4e0 \uc5d1\uc140 \uc218\uc2dd\uacfc \ud569\uacc4\ub97c \ubbff\uc5b4\ub3c4 \ub418\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\uadf8\ub300\ub85c \ubbff\uae30\ubcf4\ub2e4 \uac80\uc0b0\ud558\ub294 \uac8c \uc548\uc804\ud574\uc694. \uc6d0\ubcf8\uc744 \ub2e4\ub978 \ubc29\ubc95\uc73c\ub85c \ud569\uc0b0\ud574 \ub300\uc870\ud558\uace0, \uc140\uc744 \ub20c\ub7ec \uac12\uc774 \uc544\ub2c8\ub77c \uc218\uc2dd\uc778\uc9c0 \ud655\uc778\ud558\uc138\uc694. \uc81c \uc608\uc2dc\uc5d0\uc11c\ub294 \uc6d0\ubcf8\uc744 \ub530\ub85c \uacc4\uc0b0\ud55c \uac12\uacfc \ubaa8\ub450 \uc77c\uce58\ud588\uc5b4\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "\ub370\uc774\ud130\uc5d0 \ube48\uce78\uc774 \uc788\uc73c\uba74 \ud074\ub85c\ub4dc\uac00 \uc54c\uc544\uc11c \ucc44\uc6b0\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\uc81c \uc608\uc2dc\uc5d0\uc11c\ub294 \uc22b\uc790\ub97c \uc9c0\uc5b4 \ub123\uc9c0 \uc54a\uace0 \ube48\uce78\uc5d0 \ub178\ub780\uc0c9 \ud45c\uc2dc\uc640 \uba54\ubaa8\ub97c \ub0a8\uacbc\uc5b4\uc694. \ub2e4\ub9cc \uc694\uccad \ub0b4\uc6a9\uc5d0 \ub530\ub77c \ub2ec\ub77c\uc9c8 \uc218 \uc788\uc73c\ub2c8 \ube48\uce78\uc744 \uc5b4\ub5bb\uac8c \ucc98\ub9ac\ud560\uc9c0 \ud504\ub86c\ud504\ud2b8\uc5d0 \uc801\uc5b4 \ub450\ub294 \uac8c \uc88b\uc544\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "\ubc1b\uc740 \uc5d1\uc140\uc5d0\uc11c \ucc28\ud2b8\ub098 \uc11c\uc2dd\ub9cc \uace0\uce58\uace0 \uc2f6\uc744 \ub550 \uc5b4\ub5bb\uac8c \ud558\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\uace0\uce60 \ubd80\ubd84 \ud558\ub098\uc640 \uadf8\ub300\ub85c \ub458 \ubd80\ubd84\uc744 \ud568\uaed8 \ub9d0\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4 '\uac00\ub85c\ucd95\uc744 10/1\ucc98\ub7fc \uc6d4/\uc77c\ub85c \uace0\uce58\uace0 \ub2e4\ub978 \uc2dc\ud2b8\ub294 \uadf8\ub300\ub85c \ub450\uc138\uc694'\ucc98\ub7fc \uc694\uccad\ud558\uba74 \ud574\ub2f9 \ubd80\ubd84\ub9cc \uc218\uc815\ub3fc\uc694."
          }
        }
      ]
    }
  ],
