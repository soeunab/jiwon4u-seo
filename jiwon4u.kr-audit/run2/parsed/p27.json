        {
          "@type": "Question",
          "name": "\uc81c\ud2b8\ud14c\ub9c8\ub294 \ubb34\ub8cc\uc778\uac00\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\uacf5\uc2dd \uc0ac\uc774\ud2b8 \uae30\uc900\uc73c\ub85c \ubb34\ub8cc \ubc84\uc804(Blog)\uc774 \uc788\uc5b4\uc694. \ubcc4\ub3c4\uc758 \uc720\ub8cc \ubc84\uc804\ub3c4 \uc788\uc73c\ub2c8 \uc5b4\ub5a4 \ud30c\uc77c\uc744 \ubc1b\ub294\uc9c0\ub294 \ud655\uc778\ud574 \ubcf4\uc138\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "HTML\uc744 \ubab0\ub77c\ub3c4 \uc124\uce58\ud560 \uc218 \uc788\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\uc124\uce58\ub294 XML \ud30c\uc77c\uc744 \uc62c\ub9ac\ub294(\ubcf5\uc6d0) \uac83\ub9cc\uc73c\ub85c \ub3fc\uc694. \uc218\uc815\uc740 \ud074\ub85c\ub4dc \uac19\uc740 AI\uc5d0\uac8c \ucf54\ub4dc\ub97c \ubcf4\uc5ec \uc8fc\uba74\uc11c \uc774\uc720\ub97c \ubb3c\uc5b4\ubcf4\uba70 \uc870\uae08\uc529 \uc9c4\ud589\ud560 \uc218 \uc788\uc5b4\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "\uc218\uc815\ud558\uae30 \uc804\uc5d0 \uaf2d \ud574\uc57c \ud560 \uc77c\uc774 \uc788\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "[\ud14c\ub9c8] \ud654\uba74\uc758 [\ubc31\uc5c5]\uc73c\ub85c \ud604\uc7ac \ud14c\ub9c8\ub97c \uc800\uc7a5\ud574 \ub450\ub294 \uac70\uc608\uc694. \ubb38\uc81c\uac00 \uc0dd\uae30\uba74 \ubcf5\uc6d0\uc73c\ub85c \ub418\ub3cc\ub9b4 \uc218 \uc788\uc5b4\uc694."
          }
        }
      ]
