      "mainEntity": [
        {
          "@type": "Question",
          "name": "Draw Things\ub294 \ubb34\ub8cc\uc778\uac00\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Draw Things Free Edition\uc740 \ub85c\uceec \uc0dd\uc131, \ubaa8\ub378 \ub2e4\uc6b4\ub85c\ub4dc, \ubb34\ud55c \uce94\ubc84\uc2a4, \ub85c\uceec LoRA \ud559\uc2b5\uc744 \ubb34\ub8cc\ub85c \uc4f8 \uc218 \uc788\uc5b4\uc694. Draw Things+\ub294 \uc6d4 $8.99\ub85c \ud074\ub77c\uc6b0\ub4dc \ud55c\ub3c4\ub97c \ub192\uc5ec \uc918\uc694. \uc694\uae08\uc740 \ubc14\ub014 \uc218 \uc788\uc73c\ub2c8 \uacf5\uc2dd \uc0ac\uc774\ud2b8\uc5d0\uc11c \ud655\uc778\ud558\uc138\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "Draw Things\ub294 \uc544\uc774\ud3f0\uc5d0\uc11c\ub3c4 \uc4f8 \uc218 \uc788\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\uacf5\uc2dd \uc0ac\uc774\ud2b8\uc5d0\uc11c iPhone, iPad, Mac\uc744 \uc9c0\uc6d0\ud55c\ub2e4\uace0 \uc548\ub0b4\ud574\uc694. \uc774 \uae00\uc758 API \uc5f0\uacb0\uc740 \ub9e5\ubbf8\ub2c8\uc5d0\uc11c \ud55c \uacbd\ud5d8\uc774\uc5d0\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "Draw Things API \uc11c\ubc84\ub294 \uc5b4\ub514\uc11c \ucf1c\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\uc81c \ud654\uba74 \uae30\uc900\uc73c\ub85c \uc124\uc815 > \uc804\uccb4 \ud0ed\uc5d0\uc11c API \uc11c\ubc84\ub97c \ucf1c\uc694. \ud504\ub85c\ud1a0\ucf5c\uc740 HTTP, \ud3ec\ud2b8\ub294 7860, IP\ub294 127.0.0.1\ub85c \ub450\uace0 \ube0c\ub9ac\uc9c0 \ubaa8\ub4dc\ub294 \uaed0\uc5b4\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "\ud074\ub85c\ub4dc \ucf54\ub4dc\ub85c Draw Things \uc774\ubbf8\uc9c0\ub97c \uc5b4\ub5bb\uac8c \uc800\uc7a5\ud558\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "http://127.0.0.1:7860/sdapi/v1/txt2img \uc5d0 JSON\uc744 \ubcf4\ub0b4\uba74 \uc751\ub2f5\uc758 images \ubc30\uc5f4\uc5d0 base64 PNG\uac00 \uc640\uc694. \uc774\ub97c \ud30c\uc77c\ub85c \uc800\uc7a5\ud558\ub3c4\ub85d \ud074\ub85c\ub4dc \ucf54\ub4dc\uc5d0 \uc694\uccad\ud558\uba74 \ub3fc\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "Draw Things \ubaa8\ub378\uc740 API\ub85c \ubc1b\uc744 \uc218 \uc788\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\uc81c \uacbd\ud5d8\uc73c\ub85c\ub294 \uc548 \ub410\uc5b4\uc694. /sdapi/v1/sd-models \ub294 404\uc600\uace0, \ubaa8\ub378\uc740 \uc571 \ud654\uba74\uc5d0\uc11c \uc9c1\uc811 \ubc1b\uc544\uc57c \ud574\uc694. \ubc1b\uc740 \ud30c\uc77c \uc774\ub984\uc744 \uc694\uccad\uc758 model \uac12\uc5d0 \ub123\uc73c\uba74 \ubaa8\ub378\uc744 \ubc14\uafc0 \uc218 \uc788\uc5b4\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "\uc0dd\uc131\ud55c \uc774\ubbf8\uc9c0\ub97c \uc0c1\uc5c5\uc801\uc73c\ub85c \uc368\ub3c4 \ub418\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\ubaa8\ub378\ub9c8\ub2e4 \ub77c\uc774\uc120\uc2a4\uac00 \ub2ec\ub77c\uc11c \ubaa8\ub378 \uce74\ub4dc\ub97c \ud655\uc778\ud574\uc57c \ud574\uc694. Hugging Face \uacf5\uc2dd \ud398\uc774\uc9c0\uc5d0\uc11c FLUX.2 klein 4B\uc640 Z-Image Turbo\ub294 Apache 2.0\uc774\uc5d0\uc694."
          }
        }
      ]
