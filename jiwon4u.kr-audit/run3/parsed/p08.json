  "schema": [
    {
      "@type": "BlogPosting",
      "headline": "\ud074\ub85c\ub4dc \ucf54\ub4dc \ub73b: Claude Code\uac00 \ubb34\uc5c7\uc774\uace0 \ucc44\ud305\u00b7Cowork\uc640 \ub2e4\ub978 \uc810 \uc815\ub9ac",
      "description": "\ud074\ub85c\ub4dc \ucf54\ub4dc(Claude Code) \ub73b\uc740 \ub0b4 \ud3f4\ub354\uc758 \ucf54\ub4dc\ub97c \uc77d\uace0 \uace0\uce58\uace0 \uba85\ub839\uc744 \uc2e4\ud589\ud558\ub294 \uc5d0\uc774\uc804\ud2b8 \ucf54\ub529 \ub3c4\uad6c\uc608\uc694. \ucc44\ud305\u00b7Cowork\uc640 \ub2e4\ub978 \uc810, \uc4f0\ub294 \uacf3, \ud3ec\ud568\ub41c \uc720\ub8cc \ud50c\ub79c\uacfc \uc0ac\uc6a9 \ud55c\ub3c4\ub97c \uc815\ub9ac\ud588\uc5b4\uc694.",
      "keywords": "\ud074\ub85c\ub4dc \ucf54\ub4dc \ub73b, \ud074\ub85c\ub4dc \ucf54\ub4dc, Claude Code, \ud074\ub85c\ub4dc \ucf54\ub4dc cli \ub73b, \ud074\ub85c\ub4dc \ucf54\ub4dc \uac00\uaca9, \ud074\ub85c\ub4dc \ucf54\ub4dc \uc694\uae08\uc81c, CLAUDE.md",
      "datePublished": "2026-10-15T08:17:00+09:00",
      "dateModified": "2026-10-18T22:00:48+09:00",
      "author": {
        "@type": "Organization",
        "name": "\uc9c0\uc6d0\ud3ec\uc720"
      },
      "publisher": {
        "@type": "Organization",
        "name": "\uc9c0\uc6d0\ud3ec\uc720"
      },
      "image": "https://storage.googleapis.com/jiwon4u-blog-images/posts%2F1792029351750-95f8023f.png"
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "\ud074\ub85c\ub4dc \ucf54\ub4dc \ub73b\uc774 \ubb54\uac00\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\ud074\ub85c\ub4dc \ucf54\ub4dc(Claude Code)\ub294 \ucf54\ub4dc\ubca0\uc774\uc2a4\ub97c \uc77d\uace0 \ud30c\uc77c\uc744 \ud3b8\uc9d1\ud558\uace0 \uba85\ub839\uc744 \uc2e4\ud589\ud558\uba70 \uac1c\ubc1c \ub3c4\uad6c\uc640 \ud1b5\ud569\ud558\ub294 \uc5d0\uc774\uc804\ud2b8 \ucf54\ub529 \ub3c4\uad6c\uc608\uc694. \uae30\ub2a5\uc744 \ub9cc\ub4e4\uace0 \ubc84\uadf8\ub97c \uace0\uce58\uace0 \uac1c\ubc1c \uc791\uc5c5\uc744 \uc790\ub3d9\ud654\ud558\ub3c4\ub85d \ub3d5\ub294 AI \ucf54\ub529 \uc5b4\uc2dc\uc2a4\ud134\ud2b8\ub77c\uace0 \uc774\ud574\ud558\uba74 \ub3fc\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "\ud074\ub85c\ub4dc \ucf54\ub4dc CLI \ub73b\uc740 \ubb34\uc5c7\uc778\uac00\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "CLI\ub294 \uba85\ub839\uc904 \uc778\ud130\ud398\uc774\uc2a4\uc758 \uc904\uc784\ub9d0\ub85c, \ub9c8\uc6b0\uc2a4 \ub300\uc2e0 \ud130\ubbf8\ub110 \ucc3d\uc5d0 \uae00\uc790\ub85c \uba85\ub839\uc744 \uc785\ub825\ud558\ub294 \ubc29\uc2dd\uc774\uc5d0\uc694. \ud074\ub85c\ub4dc \ucf54\ub4dc\ub294 \ud130\ubbf8\ub110 \uc678\uc5d0\ub3c4 VS Code\u00b7JetBrains \ud655\uc7a5 \ud504\ub85c\uadf8\ub7a8, \ub370\uc2a4\ud06c\ud0d1 \uc571, \uc6f9\uc5d0\uc11c \uc4f8 \uc218 \uc788\uc5b4\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "\ud074\ub85c\ub4dc \ucf54\ub4dc \uac00\uaca9\uacfc \uc694\uae08\uc81c\ub294 \uc5b4\ub5bb\uac8c \ub418\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Claude Code\ub294 Free \ud50c\ub79c\uc5d0\ub294 \uc5c6\uace0 Pro, Max 5x, Max 20x \uac19\uc740 \uc720\ub8cc \ud50c\ub79c\uc5d0 \ud3ec\ud568\ub3fc\uc694. \ud55c\uad6d\uc5d0\uc11c \uacf5\uc2dd \uc694\uae08 \ud398\uc774\uc9c0\ub97c \uc5f4\uba74 \ubd80\uac00\uc138 \ud3ec\ud568 Pro \uc6d4 \uacb0\uc81c $22(\uc5f0\uac04 \uacb0\uc81c \uc2dc \uc6d4 $18), Max $110\ubd80\ud130\ub85c \ub098\uc640\uc694. \uc9c0\uc5ed\ub9c8\ub2e4 \ud45c\uc2dc\uac00 \ub2e4\ub97c \uc218 \uc788\uace0 \uc694\uae08\uc740 \ubc14\ub014 \uc218 \uc788\uc73c\ub2c8 \uacb0\uc81c \uc804 \uacf5\uc2dd \ud398\uc774\uc9c0\uc5d0\uc11c \ud655\uc778\ud558\uc138\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "\uac1c\ubc1c\uc790\uac00 \uc544\ub2c8\uc5b4\ub3c4 \ud074\ub85c\ub4dc \ucf54\ub4dc\ub97c \uc4f8 \uc218 \uc788\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\uc18c\ud504\ud2b8\uc6e8\uc5b4 \uac1c\ubc1c \uc791\uc5c5\uc744 \uc704\ud55c \ub3c4\uad6c\uc9c0\ub9cc, \ucf54\ub4dc\ub97c \uac70\uc758 \ubab0\ub77c\ub3c4 \ubc29\ud5a5\uc744 \uc815\ud558\uace0 \uacb0\uacfc\ub97c \ud655\uc778\ud558\ub294 \uc5ed\ud560\ub85c \uc4f8 \uc218 \uc788\uc5b4\uc694. \ub2e4\ub9cc \ucf54\ub529\uc774 \ud544\uc694 \uc5c6\ub294 \ub9ac\uc11c\uce58\ub098 \ubb38\uc11c \uc791\uc131\uc774 \ubaa9\uc801\uc774\ub77c\uba74 Cowork\uac00 \ub354 \uc5b4\uc6b8\ub824\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "\ud074\ub85c\ub4dc \ucf54\ub4dc\uac00 \ub9c8\uc74c\ub300\ub85c \ud30c\uc77c\uc744 \ubc14\uafb8\uc9c0\ub294 \uc54a\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\uacf5\uc2dd \uc81c\ud488 \ud398\uc774\uc9c0\uc5d0 \ub530\ub974\uba74 Claude Code\ub294 \uae30\ubcf8\uc801\uc73c\ub85c \ud30c\uc77c\uc744 \ubc14\uafb8\uac70\ub098 \uba85\ub839\uc744 \uc2e4\ud589\ud558\uae30 \uc804\uc5d0 \ud5c8\uac00\ub97c \uc694\uccad\ud574\uc694. \ub2e4\ub9cc \uad8c\ud55c \ubaa8\ub4dc\uc5d0 \ub530\ub77c \ub2ec\ub77c\uc9c8 \uc218 \uc788\uc5b4\uc694. \uadf8\ub798\ub3c4 \uc911\uc694\ud55c \ud30c\uc77c\uc740 \ub530\ub85c \ubc31\uc5c5\ud574 \ub450\uace0 \ubc14\ub010 \ub0b4\uc6a9\uc744 \ud655\uc778\ud558\ub294 \uc2b5\uad00\uc744 \ub4e4\uc774\ub294 \uac8c \uc88b\uc544\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "\ud074\ub85c\ub4dc \ucf54\ub4dc\ub97c \uc4f0\uba74 \ucc44\ud305 \uc0ac\uc6a9\ub7c9\ub3c4 \uc904\uc5b4\ub4dc\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\ub124, Claude Code\ub294 \ucc44\ud305\uacfc \uac19\uc740 \uc0ac\uc6a9 \ud55c\ub3c4\ub97c \ud568\uaed8 \uc368\uc694. \ud130\ubbf8\ub110 \uc791\uc5c5\uacfc \ucc44\ud305\uc774 \ud558\ub098\uc758 \uc0ac\uc6a9\ub7c9\uc5d0\uc11c \ucc28\uac10\ub418\ubbc0\ub85c, \uacc4\uc815 \uc124\uc815\uc758 \uc0ac\uc6a9\ub7c9 \ud654\uba74\uc5d0\uc11c \ud604\uc7ac \uc0ac\uc6a9 \ud604\ud669\uc744 \ud655\uc778\ud558\uc138\uc694."
          }
        }
      ]
    }
  ],
