    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "\uc62c\ub77c\ub9c8\ub294 \ubb34\ub8cc\uc778\uac00\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\uc81c\uac00 \uc4f0\ub294 \ub3d9\uc548 \uc694\uae08\uc774\ub098 \ud69f\uc218 \uc81c\ud55c\uc740 \uc5c6\uc5c8\uc5b4\uc694. \ub300\uc2e0 \ub0b4 \ucef4\ud4e8\ud130\uc758 \uba54\ubaa8\ub9ac\uc640 \uc804\ub825\uc744 \uc4f0\uace0, \ubaa8\ub378\ub9c8\ub2e4 \ub77c\uc774\uc120\uc2a4\uac00 \ub2ec\ub77c\uc11c \uc0c1\uc5c5\uc801 \uc774\uc6a9 \uc870\uac74\uc740 \ubaa8\ub378 \ud398\uc774\uc9c0\uc5d0\uc11c \ud655\uc778\ud574\uc57c \ud574\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "\uc778\ud130\ub137 \uc5c6\uc774\ub3c4 \ub418\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\ubaa8\ub378\uc744 \ud55c \ubc88 \ub0b4\ub824\ubc1b\uc740 \ub4a4\uc5d0\ub294 \uc778\ud130\ub137 \uc5f0\uacb0 \uc5c6\uc774 \ub3d9\uc791\ud574\uc694. \ub2e4\ub9cc \uc6f9 \uac80\uc0c9\uc740 \ubabb \ud574\uc11c \ucd5c\uc2e0 \uc815\ubcf4\uac00 \ud544\uc694\ud55c \uc791\uc5c5\uc5d0\ub294 \ubabb \uc368\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "\uc62c\ub77c\ub9c8 \uae30\ubcf8 \uc0ac\uc6a9\ubc95\uc774 \uad81\uae08\ud574\uc694.",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "ollama pull\ub85c \ubaa8\ub378\uc744 \ub0b4\ub824\ubc1b\uace0, ollama run\uc73c\ub85c \ub300\ud654\ud574 \ubcf4\uace0, ollama list\ub85c \uc124\uce58\ub41c \ubaa8\ub378\uc744 \ud655\uc778\ud558\ub294 \uc138 \uac00\uc9c0\ub9cc \uc54c\uba74 \uc2dc\uc791\ud560 \uc218 \uc788\uc5b4\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "\uc62c\ub77c\ub9c8 \ubaa8\ub378\uc740 \uc5b4\ub5a4 \uac78 \uace8\ub77c\uc57c \ud558\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\uc774 \uae00\uc740 gemma4:12b \uae30\uc900\uc774\uc5d0\uc694. \uac19\uc740 \uacc4\uc5f4\uc5d0 e2b, e4b, 26b, 31b\ub3c4 \uc788\uc5b4\uc11c, \ub9e5\uc758 \uba54\ubaa8\ub9ac\uc640 \ub9e1\uae38 \uc77c\uc758 \ubb34\uac8c\uc5d0 \ub9de\ucdb0 \uc62c\ub77c\ub9c8 \ubaa8\ub378 \ud398\uc774\uc9c0\uc5d0\uc11c \ube44\uad50\ud574 \ubcf4\uc138\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "\ub85c\uceec \ubaa8\ub378\ub85c \uc6d0\uace0 \ubcf8\ubb38\ub3c4 \uc4f8 \uc218 \uc788\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\uae30\uc220\uc801\uc73c\ub85c\ub294 \uac00\ub2a5\ud574\ub3c4 \uc800\ub294 \ub9e1\uae30\uc9c0 \uc54a\uc558\uc5b4\uc694. \uae34 \uae00\uc5d0\uc11c \uaddc\uce59\uc744 \ub193\uce58\ub294 \uc77c\uc774 \uc7a6\uc558\uace0, \uc6f9 \uac80\uc0c9\uc73c\ub85c \uc0ac\uc2e4\uc744 \ud655\uc778\ud560 \uc218\ub3c4 \uc5c6\uae30 \ub54c\ubb38\uc774\uc5d0\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "JSON \uc7ac\uc2dc\ub3c4\ub294 \uba87 \ubc88 \ud558\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\ud55c \ubc88\uc774\uc5d0\uc694. \uc5b4\ub514\uac00 \ud2c0\ub838\ub294\uc9c0 \uc54c\ub824\uc8fc\uace0 \ub2e4\uc2dc \uc694\uccad\ud558\ub294 \ubc29\uc2dd\uc774\uc5d0\uc694."
          }
        }
      ]
    }
