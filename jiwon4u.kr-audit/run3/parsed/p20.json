      "headline": "\ud074\ub85c\ub4dc \ube14\ub85c\uadf8 \uc790\ub3d9\ud654 \uae00\uc4f0\uae30: AI\uac00 \uc4f4 \uae00, \uc0ac\ub78c \uac80\uc218 \uc5c6\uc774\ub294 \uacf5\uac1c \ubabb \ud558\uac8c \ub9cc\ub4e0 \uc774\uc720",
      "description": "\ud074\ub85c\ub4dc \ube14\ub85c\uadf8 \uc790\ub3d9\ud654 \uae00\uc4f0\uae30\uc5d0\uc11c AI\uac00 \uc4f4 \uae00\uc744 \uc0ac\ub78c \uac80\uc218 \uc5c6\uc774\ub294 \uacf5\uac1c\ud558\uc9c0 \ubabb\ud558\uac8c \ub9cc\ub4e0 \uc774\uc720\uc608\uc694. \ube44\uacf5\uac1c \ubc1c\ud589, \uacbd\ud5d8 \uc790\ub9ac \ube44\uc6cc \ub450\uae30, \uc0ac\uc2e4 \uac80\uc218 2\ub2e8\uacc4\ub85c \ud655\uc778\ud560 \ud56d\ubaa9\uc744 18\uac1c\uc5d0\uc11c 6\uac1c\ub85c \uc904\uc778 \uacfc\uc815\uc744 \ucc28\ub840\ub85c \uc815\ub9ac\ud588\uc5b4\uc694.",
      "keywords": "\ube14\ub85c\uadf8\uc790\ub3d9\ud654, \ud074\ub85c\ub4dc",
