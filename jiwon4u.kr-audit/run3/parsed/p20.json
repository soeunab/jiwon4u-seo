    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "\uc0ac\ub78c \uac80\uc218 \uc5c6\uc774 \uc790\ub3d9\uc73c\ub85c \uacf5\uac1c\ud574 \uc8fc\ub294 \uae30\ub2a5\uc740 \uc5c6\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\uc5c6\uc5b4\uc694. \ube44\uacf5\uac1c\ub85c \uc62c\ub9ac\uace0, \uc0ac\ub78c\uc774 \ud655\uc778\ud558\uace0, \uacf5\uac1c\ub85c \ubc14\uafb8\ub294 \uc21c\uc11c\ub97c \uac74\ub108\ub6f0\ub294 \uacbd\ub85c \uc790\uccb4\ub97c \ub9cc\ub4e4\uc9c0 \uc54a\uc558\uc5b4\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "[\uacbd\ud5d8 \ucd94\uac00]\ub97c \uc548 \ucc44\uc6b0\uace0 \ubc1c\ud589\ud558\uba74 \uc5b4\ub5bb\uac8c \ub418\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\uadf8 \uc790\ub9ac\ub294 \ubc1c\ud589\ubcf8\uc5d0\uc11c \uc790\ub3d9\uc73c\ub85c \ube60\uc838\uc694. \uc5b4\uc0c9\ud55c \ube48 \ubb38\uc7a5\uc774 \ub0a8\uc9c0\ub294 \uc54a\uc544\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "\uac80\uc218 \ud56d\ubaa9\uc5d0 \uac78\ub9ac\uba74 \ubc1c\ud589\uc774 \ub9c9\ud788\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\ub9c9\ud788\uc9c0 \uc54a\uc544\uc694. \uc774\uc720\ub97c \uc77d\uc744 \uc218 \uc788\ub294 \ubb38\uc7a5\uc73c\ub85c \ubcf4\uc5ec\uc8fc\uace0, \uc81c\uac00 \ud655\uc778\ud55c \ub4a4 \u201c\uadf8\ub798\ub3c4 \uc2b9\uc778\u201d\uc744 \ub204\ub97c \uc218 \uc788\uc5b4\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "AI\uac00 \uc2a4\uc2a4\ub85c \uace0\uce5c \ubd80\ubd84\uc740 \ubbff\uc5b4\ub3c4 \ub418\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\ud655\uc778\ub418\ub294 \uac74 AI\uac00 \ud55c \ubc88 \ub354 \uac80\uc0c9\ud574\uc11c \uace0\uce58\uac8c \ud588\uace0, \ubabb \uace0\uce5c \uac83\ub9cc \uc0ac\ub78c\uc5d0\uac8c \ub118\uaca8\uc694. \uadf8\ub798\ub3c4 \ucd5c\uc885 \ud655\uc778\uc740 \uc0ac\ub78c\uc774 \ud574\uc694. \uc644\ubcbd\ud558\ub2e4\uace0 \ubcf4\uc7a5\ud560 \uc218\ub294 \uc5c6\uc5b4\uc694."
          }
        }
      ]
    }
  ],
