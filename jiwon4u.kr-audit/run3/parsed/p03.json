    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "\ud074\ub85c\ub4dc \ucf54\ub4dc \ubb34\ub8cc\ub85c \uc4f8 \uc218 \uc788\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Free \ud50c\ub79c\uc5d0\uc11c\ub294 Claude Code\ub97c \uc4f8 \uc218 \uc5c6\uc5b4\uc694. \uacf5\uc2dd \uc694\uae08 \ud398\uc774\uc9c0\uc5d0\ub294 \ubaa8\ub4e0 \uc720\ub8cc \ud50c\ub79c\uc5d0 \ud3ec\ud568\ub41c\ub2e4\uace0 \uc548\ub0b4\ub3fc \uc788\uace0, \uac1c\uc778\uc740 Pro\ubd80\ud130 \uc2dc\uc791\ud558\uba74 \ub3fc\uc694. \uc694\uae08\uc740 \ubc14\ub014 \uc218 \uc788\uc73c\ub2c8 \uacb0\uc81c \uc804 \uacf5\uc2dd \ud398\uc774\uc9c0\uc5d0\uc11c \ud655\uc778\ud558\uc138\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "\ud074\ub85c\ub4dc \ucf54\ub4dc \uc694\uae08\uc81c\ub294 \uc5b4\ub5a4 \uac78 \uace8\ub77c\uc57c \ud558\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\ucc98\uc74c\uc774\ub77c\uba74 Pro\ub85c \uc2dc\uc791\ud574 \ud55c\ub3c4\uac00 \ubd80\uc871\ud560 \ub54c Max\ub97c \uace0\ub824\ud558\ub294 \ud750\ub984\uc774 \ubb34\ub09c\ud574\uc694. \ud55c\uad6d\uc5b4 \uc694\uae08 \ud398\uc774\uc9c0 \uae30\uc900(\ubd80\uac00\uc138 \ud3ec\ud568) Pro\ub294 \uc6d4\ubcc4 \uacb0\uc81c \uc2dc \uc6d4 $22, \uc5f0\uac04 \uacb0\uc81c \uc2dc \uc6d4 $18\uc774\uace0 Max\ub294 \uc6d4 $110\ubd80\ud130\uc608\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "\ud074\ub85c\ub4dc\ucf54\ub4dc \uc124\uce58\ubc29\ubc95\uc740 \ub9e5\uacfc \uc708\ub3c4\uc6b0\uac00 \ub2e4\ub978\uac00\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\ub124, \uba85\ub839\uc774 \ub2ec\ub77c\uc694. macOS\u00b7Linux\u00b7WSL\uc740 curl \uba85\ub839, Windows\ub294 PowerShell\uc758 irm \uba85\ub839\uc774\ub098 CMD\uc6a9 \uba85\ub839\uc744 \uc368\uc694. \uc124\uce58 \ud6c4\uc5d0\ub294 \uc0c8 \ud130\ubbf8\ub110\uc5d0\uc11c claude --version\uc73c\ub85c \ud655\uc778\ud558\uc138\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "\uc124\uce58\ud588\ub294\ub370 command not found: claude\ub77c\uace0 \ub098\uc640\uc694.",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\uc124\uce58 \ud3f4\ub354(~/.local/bin)\uac00 PATH\uc5d0 \ub4e4\uc5b4\uac00\uc9c0 \uc54a\uc544\uc11c \uadf8\ub798\uc694. \ub9e5\uc774\ub77c\uba74 \uc124\uce58 \ud654\uba74 \uc548\ub0b4\ub300\ub85c echo 'export PATH=\"$HOME/.local/bin:$PATH\"' >> ~/.zshrc && source ~/.zshrc \ub97c \ud55c \ubc88 \uc2e4\ud589\ud55c \ub4a4 claude --version\uc744 \ub2e4\uc2dc \uc785\ub825\ud558\uc138\uc694. \uadf8\ub798\ub3c4 \uc548 \ub418\uba74 \ud130\ubbf8\ub110\uc744 \uc644\uc804\ud788 \ub2eb\uc558\ub2e4 \ub2e4\uc2dc \uc5ec\uc138\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "CLAUDE.md\ub294 \uaf2d \ub9cc\ub4e4\uc5b4\uc57c \ud558\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\ud544\uc218\ub294 \uc544\ub2c8\uc9c0\ub9cc \ub9cc\ub4e4\uc5b4 \ub450\uba74 \ud3b8\ud574\uc694. \ub9e4 \uc138\uc158 \uc2dc\uc791 \ub54c \uc77d\ub294 \ud30c\uc77c\uc774\ub77c \ud504\ub85c\uc81d\ud2b8 \uaddc\uce59\uc744 \ubc18\ubcf5\ud574\uc11c \uc124\uba85\ud558\uc9c0 \uc54a\uc544\ub3c4 \ub3fc\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "\uc774\uc804\uc5d0 \ud558\ub358 \ub300\ud654\ub97c \uc774\uc5b4\uc11c \ud558\ub824\uba74 \uc5b4\ub5bb\uac8c \ud558\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\ud130\ubbf8\ub110\uc5d0\uc11c claude -c\ub97c \uc785\ub825\ud558\uba74 \ud604\uc7ac \ud3f4\ub354\uc758 \ucd5c\uadfc \ub300\ud654\ub97c \uc774\uc5b4\uac00\uc694. \uc774\uc804 \ub300\ud654\ub97c \uace8\ub77c \ub2e4\uc2dc \uc5f4\ub824\uba74 claude -r\uc774\ub098 \uc138\uc158 \uc548\uc758 /resume\uc744 \uc4f0\uc138\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "claude\ub97c \uc2e4\ud589\ud588\ub354\ub2c8 No, exit / Yes, I trust this folder\uac00 \ub098\uc640\uc694. \ubb58 \uace8\ub77c\uc57c \ud558\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\ub0b4\uac00 \ub9cc\ub4e0 \ud3f4\ub354\ub098 \ubbff\uc744 \uc218 \uc788\ub294 \ud3f4\ub354\ub77c\uba74 \uc544\ub798 \ud654\uc0b4\ud45c\ub85c Yes, I trust this folder\ub97c \uace0\ub974\uace0 \uc5d4\ud130\ub97c \ub204\ub974\uc138\uc694. \ucc98\uc74c\uc5d0\ub294 No, exit\uc5d0 \uc120\ud0dd\ub3fc \uc788\uc5b4\uc11c \ubc14\ub85c \uc5d4\ud130\ub97c \ub204\ub974\uba74 \ud074\ub85c\ub4dc \ucf54\ub4dc\uac00 \uaebc\uc838\uc694. \ub0b4\uc6a9\uc744 \ubaa8\ub974\ub294 \ud3f4\ub354\ub77c\uba74 No\ub97c \uace0\ub974\uace0 \uba3c\uc800 \ud655\uc778\ud558\uc138\uc694."
          }
        }
      ]
    }
  ],
