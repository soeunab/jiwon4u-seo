          }
        },
        {
          "@type": "Question",
          "name": "\ub9e5\uc740 \uc778\ud154\uacfc \uc560\ud50c \uc2e4\ub9ac\ucf58 \uc911 \uc5b4\ub5a4 \ud30c\uc77c\uc744 \ubc1b\uc544\uc57c \ud558\ub098\uc694?",
