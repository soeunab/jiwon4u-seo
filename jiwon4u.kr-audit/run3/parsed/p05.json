    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "\ud074\ub85c\ub4dc \uc2a4\ud0ac\uc740 \ubb34\ub8cc \ud50c\ub79c\uc5d0\uc11c\ub3c4 \uc4f8 \uc218 \uc788\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\uacf5\uc2dd \uc9c0\uc6d0 \ubb38\uc11c\uc5d0\ub294 Free\u00b7Pro\u00b7Max\u00b7Team\u00b7Enterprise \ud50c\ub79c\uc5d0\uc11c \uc2a4\ud0ac\uc744 \uc4f8 \uc218 \uc788\uace0 \ucf54\ub4dc \uc2e4\ud589\uc774 \ucf1c\uc838 \uc788\uc5b4\uc57c \ud55c\ub2e4\uace0 \uc801\ud600 \uc788\uc5b4\uc694. \ub2e4\ub9cc \ud50c\ub79c \uc815\ucc45\uc740 \ubc14\ub014 \uc218 \uc788\uc73c\ub2c8 \uc0ac\uc6a9 \uc804 \uacf5\uc2dd \ud398\uc774\uc9c0\uc5d0\uc11c \ud655\uc778\ud558\uc138\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "\ud074\ub85c\ub4dc \uc2a4\ud0ac\uc774 \ucf1c\uc838 \uc788\ub294\ub370 \uc548 \ubd88\ub7ec\uc640\uc694. \uc5b4\ub5bb\uac8c \ud558\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\uba3c\uc800 \ucf54\ub4dc \uc2e4\ud589 \ubc0f \ud30c\uc77c \uc0dd\uc131\uc774 \ucf1c\uc838 \uc788\ub294\uc9c0, \uc0ac\uc6a9\uc790 \uc9c0\uc815 > Skills\uc5d0\uc11c \ud574\ub2f9 \uc2a4\ud0ac\uc774 \ucf1c\uc838 \uc788\ub294\uc9c0 \ud655\uc778\ud558\uc138\uc694. \uadf8\ub2e4\uc74c \uc2a4\ud0ac \uc124\uba85(description)\uc5d0 \uc5b8\uc81c \uc4f0\ub294\uc9c0\uac00 \ubd84\uba85\ud788 \uc801\ud600 \uc788\ub294\uc9c0 \ubcf4\uc138\uc694. \uadf8\ub798\ub3c4 \uc548 \ub418\uba74 \uc694\uccad\uc5d0 \uc2a4\ud0ac \uc774\ub984\uc744 \uc9c1\uc811 \uc801\uc5b4 \ubcf4\uc138\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "\ud074\ub85c\ub4dc \uc2a4\ud0ac\uc740 \ud504\ub86c\ud504\ud2b8\ub098 \ud504\ub85c\uc81d\ud2b8\uc640 \ubb50\uac00 \ub2e4\ub978\uac00\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\ud504\ub86c\ud504\ud2b8\ub294 \uadf8 \ub300\ud654\uc5d0\uc11c \ud55c \ubc88 \uc4f0\ub294 \uc9c0\uc2dc\uc774\uace0, \uc2a4\ud0ac\uc740 \ud30c\uc77c\ub85c \uc800\uc7a5\ud574 \ub450\uace0 \ud544\uc694\ud560 \ub54c \ubd88\ub7ec \uc4f0\ub294 \uc791\uc5c5 \ubc29\uc2dd\uc774\uc5d0\uc694. \uc2a4\ud0ac\uc740 \ucc98\uc74c\uc5d0\ub294 \uc774\ub984\uacfc \uc124\uba85\ub9cc \uc77d\ud788\uace0, \ud638\ucd9c\ub420 \ub54c \ubcf8\ubb38\uc774 \uc77d\ud788\ub294 \uad6c\uc870\uc608\uc694. \ud504\ub85c\uc81d\ud2b8\ub294 \uc790\ub8cc\uc640 \ub9e5\ub77d\uc744 \ubb36\uc5b4 \ub450\ub294 \uacf5\uac04\uc774\ub77c \uc5ed\ud560\uc774 \ub2ec\ub77c\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "\ud074\ub85c\ub4dc \uc2a4\ud0ac\uc740 \uc544\ubb34 \uacf3\uc5d0\uc11c \ubc1b\uc544 \uc368\ub3c4 \ub418\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\uc544\ub2c8\uc694. \uacf5\uc2dd \ubb38\uc11c\ub294 \ubbff\uc744 \uc218 \uc788\ub294 \ucd9c\ucc98\uc758 \uc2a4\ud0ac\ub9cc \uc124\uce58\ud558\ub77c\uace0 \uc548\ub0b4\ud574\uc694. \ucd9c\ucc98\uac00 \ubd88\ubd84\uba85\ud55c \uc2a4\ud0ac\uc740 \ud504\ub86c\ud504\ud2b8 \uc778\uc81d\uc158\uc774\ub098 \ub370\uc774\ud130 \uc720\ucd9c \uc704\ud5d8\uc774 \uc788\uc744 \uc218 \uc788\uc5b4\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "\uc785\ub825\ucc3d\uc5d0\uc11c /\ub97c \uce58\uba74 \uc2a4\ud0ac \ubaa9\ub85d\uc774 \ub098\uc624\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\uc81c \ud654\uba74\uc5d0\uc11c\ub294 \uc0c8 \ucc44\ud305 \uc785\ub825\ucc3d\uc5d0 /\ub97c \uce58\uba74 \uc2a4\ud0ac \ubaa9\ub85d\uc774 \ub5b4\uc5b4\uc694. \ub2e4\ub9cc \uc774 \ub3d9\uc791\uc740 \uacf5\uc2dd \uc9c0\uc6d0 \ubb38\uc11c\uc5d0\uc11c \ud655\uc778\ud558\uc9c0 \ubabb\ud588\uc5b4\uc694. \uacc4\uc815\uc774\ub098 \ud654\uba74\uc5d0 \ub530\ub77c \ub2e4\ub97c \uc218 \uc788\uc73c\ub2c8 \uc548 \ubcf4\uc774\uba74 \uc2a4\ud0ac \uc774\ub984\uc744 \uc9c1\uc811 \ub9d0\ud574\uc11c \uc694\uccad\ud558\uc138\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "\uc2a4\ud0ac\uc744 \uc4f0\uba74 \uacb0\uacfc\ub97c \ubbff\uace0 \uadf8\ub300\ub85c \uc368\ub3c4 \ub418\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\uadf8\ub300\ub85c \uc4f0\uae30\ubcf4\ub2e4 \uc0ac\ub78c\uc774 \ub9c8\uc9c0\ub9c9\uc73c\ub85c \ud655\uc778\ud558\ub294 \ud3b8\uc774 \uc88b\uc544\uc694. \uc81c\uac00 \uc4f4 \ube14\ub85c\uadf8 \uac80\uc218 \uc2a4\ud0ac\ub3c4 \uc2dc\uc810 \ud45c\ud604\uc740 \uc798 \uc7a1\uc558\uc9c0\ub9cc, \uc6d0\uace0\uc5d0 \ub0a8\uc740 \u2018\uacbd\ud5d8 \ucd94\uac00\u2019 \ubb38\uad6c\ub294 \ub193\ucce4\uc5b4\uc694. \uc2a4\ud0ac\uc740 \uac80\ud1a0\ub97c \ub3d5\ub294 \ub3c4\uad6c\ub85c \uc4f0\uc138\uc694."
          }
        }
      ]
    }
  ],
