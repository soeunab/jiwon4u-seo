      "@type": "BlogPosting",
      "headline": "\ud074\ub85c\ub4dc \uc2a4\ud0ac \uc0ac\uc6a9\ubc95\uacfc \ucd94\ucc9c: \ucf1c\ub294 \ubc95\ubd80\ud130 \ubd88\ub7ec \uc4f0\ub294 \ubc29\ubc95\uae4c\uc9c0 \uc815\ub9ac",
      "description": "\ud074\ub85c\ub4dc \uc2a4\ud0ac \uc0ac\uc6a9\ubc95\uc744 \uc815\ub9ac\ud588\uc5b4\uc694. \ucf54\ub4dc \uc2e4\ud589 \uc124\uc815\uc744 \ucf1c\uace0 \uc0ac\uc6a9\uc790 \uc9c0\uc815 > Skills\uc5d0\uc11c \uc2a4\ud0ac\uc744 \ucf1c\ub294 \ubc95, \uc54c\uc544\uc11c \ubd88\ub7ec\uc624\uae30\uc640 / \uc785\ub825\uc73c\ub85c \uace0\ub974\ub294 \ubc95, \uac80\uc218 \uc2a4\ud0ac\uc744 \uc2e4\uc81c\ub85c \uc368 \ubcf8 \uacb0\uacfc\uae4c\uc9c0 \ub2f4\uc558\uc5b4\uc694.",
      "keywords": "\ud074\ub85c\ub4dc \uc2a4\ud0ac, \ud074\ub85c\ub4dc \uc2a4\ud0ac \uc0ac\uc6a9\ubc95, \ud074\ub85c\ub4dc \uc2a4\ud0ac \ucd94\ucc9c, claude skills, \ud074\ub85c\ub4dc skill",
      "datePublished": "2026-10-16T08:32:06+09:00",
      "dateModified": "2026-10-18T22:00:43+09:00",
      "author": {
        "@type": "Organization",
        "name": "\uc9c0\uc6d0\ud3ec\uc720"
      },
      "publisher": {
