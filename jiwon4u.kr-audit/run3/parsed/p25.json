    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "\ud074\ub85c\ub4dc \ube14\ub85c\uadf8 \uc790\ub3d9\ud654\uc5d0\uc11c API \uc694\uae08\uc740 \uc815\ub9d0 \uc548 \ub098\uac00\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\uae00\uc4f0\uae30\ub294 \uad6c\ub3c5 \ub85c\uadf8\uc778 \ubc29\uc2dd\uc774\ub77c API \uc694\uae08\uc774 \ub530\ub85c \ub098\uac00\uc9c0 \uc54a\ub3c4\ub85d \uc124\uacc4\ud588\uc5b4\uc694. \ub2e4\ub9cc \uc774\ubbf8\uc9c0 \uc0dd\uc131\uc740 \ubb34\ub8cc \ud2f0\uc5b4\uac00 \uc5c6\ub294 \uc81c\ubbf8\ub098\uc774 API\ub77c\uc11c, \uad6c\uae00 AI \uc2a4\ud29c\ub514\uc624\uc5d0\uc11c \uc6d4 5,000\uc6d0 \ud55c\ub3c4\ub97c \uac78\uc5b4 \ub480\uc5b4\uc694. \uad6c\ub3c5\uc5d0\ub3c4 \uc0ac\uc6a9 \ud55c\ub3c4\uac00 \uc788\uc5b4\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "Claude \ucc44\ud305\ub9cc\uc73c\ub85c\ub3c4 \uc774\ub807\uac8c \uc790\ub3d9\ud654\ud560 \uc218 \uc788\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\uc81c \uad6c\uc870\ub294 \ud504\ub85c\uadf8\ub7a8\uc774 Claude Code\ub97c \ud130\ubbf8\ub110\uc5d0\uc11c \uc9c1\uc811 \ubd88\ub7ec\uc694. \ucc44\ud305 \ud654\uba74\ub9cc\uc73c\ub85c\ub294 \ud504\ub85c\uadf8\ub7a8\uc774 \ub300\uc2e0 \ud638\ucd9c\ud560 \uc218 \uc5c6\uc5b4\uc11c, \uadf8 \uacbd\uc6b0\ub97c \uc704\ud574 \ubcf5\uc0ac\ud574\uc11c \ubd99\uc5ec\ub123\ub294 \uc218\ub3d9 \ubaa8\ub4dc\ub97c \ub0a8\uaca8 \ub480\uc5b4\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "\uc0ac\ub78c \uac80\uc218 \uc5c6\uc774 \uc790\ub3d9\uc73c\ub85c \uacf5\uac1c \ubc1c\ud589\ub3c4 \ub418\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\uc548 \ub418\uac8c \ub9cc\ub4e4\uc5c8\uc5b4\uc694. \ube44\uacf5\uac1c \ubc1c\ud589, \uc0ac\ub78c \ud655\uc778, \uacf5\uac1c \uc804\ud658 \uc21c\uc11c\uac00 \ud56d\uc0c1 \uc9c0\ucf1c\uc838\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "\uc6d4 5,000\uc6d0 \ud55c\ub3c4\ub294 5,000\uc6d0\uae4c\uc9c0 \ubb34\ub8cc\ub77c\ub294 \ub73b\uc778\uac00\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\uc544\ub2c8\uc5d0\uc694. \uc774\ubbf8\uc9c0 \ubaa8\ub378\uc740 \ubb34\ub8cc \ud2f0\uc5b4\uac00 \uc5c6\uc5b4\uc11c \uc4f4 \ub9cc\ud07c \uc694\uae08\uc774 \uc313\uc774\uace0, 5,000\uc6d0\uc740 \uadf8 \uc704\ub85c \ubabb \ub118\uac8c \ub9c9\ub294 \uc0c1\ud55c\uc774\uc5d0\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "\uc81c\ubbf8\ub098\uc774 \uc774\ubbf8\uc9c0 API \uc694\uae08\uc774 \uacfc\ud558\uac8c \ub098\uc624\uba74 \uc5b4\ub5a1\ud558\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\uad6c\uae00 AI \uc2a4\ud29c\ub514\uc624\uc758 \ud504\ub85c\uc81d\ud2b8 \uc6d4 \uc9c0\ucd9c \ud55c\ub3c4\ub85c \ub9c9\uc744 \uc218 \uc788\uc5b4\uc694. \uc800\ub294 \uc6d4 5,000\uc6d0\uc73c\ub85c \uc124\uc815\ud588\uace0, \ud55c\ub3c4\uc5d0 \ub2ff\uc73c\uba74 \uadf8 \ub2ec\uc5d0\ub294 \uc694\uccad\uc774 \uba48\ucdb0\uc694. \ub2e4\ub9cc \ubc18\uc601\uc5d0 10\ubd84 \uc815\ub3c4 \uc9c0\uc5f0\uc774 \uc788\uc5b4\uc11c \uc870\uae08 \ub118\uc744 \uc218 \uc788\uc5b4\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "\uc5b4\ub5a4 \ube14\ub85c\uadf8\uc5d0 \ubc1c\ud589\ud560 \uc218 \uc788\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\uad6c\uae00 \ube14\ub85c\uac70\uc640 \ub124\uc774\ubc84 \ube14\ub85c\uadf8\ub97c \ub300\uc0c1\uc73c\ub85c \ub9cc\ub4e4\uc5c8\uace0, \uc2e4\uc81c\ub85c \uad6c\uae00 \ube14\ub85c\uac70 \uacc4\uc815\uacfc \ub124\uc774\ubc84 \uacc4\uc815 3\uac1c\ub97c \uc5f0\uacb0\ud574 \ud14c\uc2a4\ud2b8\ud588\uc5b4\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "\ub85c\uceec \ubaa8\ub378\uc740 \uc65c \uac19\uc774 \uc4f0\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\uce74\ub4dc\ub274\uc2a4 \ubb38\uad6c\ub098 \ucea1\uc158 \uac19\uc740 \uac00\ubcbc\uc6b4 \uc77c\uae4c\uc9c0 \uad6c\ub3c5 \ud55c\ub3c4\ub97c \uc4f8 \uc774\uc720\uac00 \uc5c6\uc5b4\uc11c\uc608\uc694. \uc5b4\ub5a4 \uc77c\uc744 \ub9e1\uae30\uace0 \uc548 \ub9e1\uacbc\ub294\uc9c0\ub294 \ubcf8\ud3b8 3\uc5d0 \uc815\ub9ac\ud588\uc5b4\uc694."
          }
        }
      ]
    }
