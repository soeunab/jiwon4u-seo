  "schema": [
    {
      "@type": "BlogPosting",
      "headline": "\ud074\ub85c\ub4dc API \uad6c\ub3c5 \ucc28\uc774: \uad6c\ub3c5\uc73c\ub85c \uc4f8 \ub54c\uc640 API \ud0a4\ub85c \uc4f8 \ub54c \uc694\uae08\uc740 \uc774\ub807\uac8c \ub2ec\ub77c\uc694",
      "description": "\ud074\ub85c\ub4dc API \uad6c\ub3c5 \ucc28\uc774\ub97c \uc694\uae08, \ud55c\ub3c4, \uc4f0\ub294 \uacf3\uc73c\ub85c \ub098\ub220 \uc815\ub9ac\ud588\uc5b4\uc694. \uad6c\ub3c5\uc740 \uc6d4 \uc815\uc561\uc5d0 \uc0ac\uc6a9 \ud55c\ub3c4\uac00 \uc788\uace0 API\ub294 \uc4f4 \ub9cc\ud07c \ud1a0\ud070\ub2f9 \uacb0\uc81c\uc608\uc694. Claude Code\uc5d0\uc11c API \ud0a4 \ud658\uacbd\ubcc0\uc218 \ub54c\ubb38\uc5d0 \uc694\uae08\uc774 \ub098\uac00\ub294 \uacbd\uc6b0\ub3c4 \ud568\uaed8 \uc124\uba85\ud574\uc694.",
      "keywords": "\ube14\ub85c\uadf8\uc790\ub3d9\ud654, \ud074\ub85c\ub4dc",
      "datePublished": "2026-10-06T19:18:20+09:00",
