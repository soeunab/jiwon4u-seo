      },
      "image": "https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEiM4V-PtK3IX3os2AmF2hLh3kr-_pKT4FSvuCWvjIBeRshGbxHOpEzLHC8XjVd68Ml4lUwB44457Q580HNHrN9esWlqAVUnFQSPyyfoAxyyMsTW5LhgQJ_SxZNxLPp7JBW_-kl9i9LL6h2Lt_xn0R9DqetcrssNWLKe4jmIQdyB6StFR3J6pDCrxnBtHAA/s1200/claude-api-vs-subscription-thumbnail.webp",
      "mainEntityOfPage": "https://www.jiwon4u.kr/2026/10/claude-api-vs-subscription-difference.html"
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "\ud074\ub85c\ub4dc \uad6c\ub3c5\uc774 \uc788\uc73c\uba74 API\ub3c4 \ubb34\ub8cc\ub85c \uc4f8 \uc218 \uc788\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Free\uc640 Pro\ub294 \uc544\ub2c8\uc5d0\uc694. \uad6c\ub3c5\uc740 claude.ai\uc640 Claude Code\ub97c \uc4f0\ub294 \uacc4\uc815\uc774\uace0, API\ub294 \uac1c\ubc1c\uc790 \ucf58\uc194\uc5d0\uc11c \ub530\ub85c \ud06c\ub808\ub527\uc744 \ucda9\uc804\ud574 \uc4f0\ub294 \ubcc4\uac1c\uc758 \uacb0\uc81c\uc608\uc694. \ub2e4\ub9cc Max \uc694\uae08\uc81c\uc5d0\ub294 Claude Platform\uc5d0\uc11c \uc4f8 \uc218 \uc788\ub294 API \ud06c\ub808\ub527\uc774 \ub9e4\ub2ec \ub4e4\uc5b4 \uc788\uc5b4\uc694(Max 5x \uc6d4 100\ub2ec\ub7ec, Max 20x \uc6d4 200\ub2ec\ub7ec). \uc774 \ud06c\ub808\ub527\uc740 Claude Console \uc870\uc9c1\uc5d0 \ubc1b\uc544\uc11c API \ud0a4\ub85c \uc4f0\ub294 \uac83\uc774\ub77c Claude Code(\ub300\ud654\ud615)\ub098 claude.ai\uc5d0\ub294 \uc4f8 \uc218 \uc5c6\uc5b4\uc694. \ub2e4 \uc4f0\uba74 \ub530\ub85c \ucda9\uc804\ud55c \ud06c\ub808\ub527\uc774 \uc5c6\ub294 \ud55c \ub2e4\uc74c \ub2ec \ud06c\ub808\ub527\uc774 \ub4e4\uc5b4\uc62c \ub54c\uae4c\uc9c0 API \uc694\uccad\uc774 \uba48\ucd94\uace0, \uad6c\ub3c5 \uc694\uae08\uc73c\ub85c \uccad\uad6c\ub418\uc9c0\ub294 \uc54a\uc544\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "\uad6c\ub3c5 \ud55c\ub3c4\uc5d0 \ub2ff\uc73c\uba74 \uc790\ub3d9\uc73c\ub85c \ub3c8\uc774 \ub098\uac00\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\uae30\ubcf8\uc801\uc73c\ub85c\ub294 \uc544\ub2c8\uc5d0\uc694. \uc0ac\uc6a9 \ud06c\ub808\ub527\uc744 \uc9c1\uc811 \ucf1c \ub450\uc5c8\uac70\ub098, Claude Code\uc5d0\uc11c API \ud06c\ub808\ub527\uc73c\ub85c \ub118\uc5b4\uac00\uaca0\ub2e4\uace0 \ub3d9\uc758\ud55c \uacbd\uc6b0\uc5d0\ub9cc API \uc694\uae08\uc73c\ub85c \uc774\uc5b4\uc838\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "Claude Code\ub97c \uc4f0\ub294\ub370 \uac11\uc790\uae30 \uc694\uae08\uc774 \ub098\uc654\uc5b4\uc694. \uc65c \uadf8\ub7f4\uae4c\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\ucef4\ud4e8\ud130\uc5d0 ANTHROPIC_API_KEY \ud658\uacbd\ubcc0\uc218\uac00 \uc124\uc815\ub3fc \uc788\uc73c\uba74 \uad6c\ub3c5 \ub300\uc2e0 API \ud0a4\uac00 \uc4f0\uc5ec\uc11c \uadf8\ub7f4 \uc218 \uc788\uc5b4\uc694. /cost\ub85c \uc9c0\ucd9c\uc744 \ud655\uc778\ud558\uace0, \ud658\uacbd\ubcc0\uc218\ub97c \uc9c0\uc6b4 \ub4a4 /login\uc73c\ub85c \uad6c\ub3c5 \uacc4\uc815\uc5d0 \ub2e4\uc2dc \ub85c\uadf8\uc778\ud574 \ubcf4\uc138\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "\ubb34\ub8cc \ud50c\ub79c\uc73c\ub85c Claude Code\ub97c \uc4f8 \uc218 \uc788\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\uacf5\uc2dd \uc694\uae08\uc81c \ube44\uad50\ud45c\uc5d0\uc11c Claude Code\ub294 Pro \uc774\uc0c1 \uc720\ub8cc \ud50c\ub79c\ubd80\ud130 \ud3ec\ud568\ub3fc\uc694. \ubb34\ub8cc \ud50c\ub79c\uc5d0\uc11c\ub294 \uc4f8 \uc218 \uc5c6\uc5b4\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "API \uac00\uaca9\uc740 \ubaa8\ub378\ub9c8\ub2e4 \ub2e4\ub978\uac00\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\ub124, \ubaa8\ub378\ub9c8\ub2e4 \uc785\ub825\uacfc \ucd9c\ub825 \uac00\uaca9\uc774 \ub2ec\ub77c\uc694. \ud070 \ubaa8\ub378\uc77c\uc218\ub85d \ube44\uc2f8\uace0, \uac00\uc7a5 \uc791\uc740 Haiku \uacc4\uc5f4\uc774 \uac00\uc7a5 \uc800\ub834\ud574\uc694."
          }
        }
      ]
    }
  ],
