    "\ud074\ub85c\ub4dc \uc2a4\ud0ac \uc0ac\uc6a9\ubc95\uacfc \ucd94\ucc9c: \ucf1c\ub294 \ubc95\ubd80\ud130 \ubd88\ub7ec \uc4f0\ub294 \ubc29\ubc95\uae4c\uc9c0 \uc815\ub9ac",
    "\uad6c\uae00 \ube14\ub85c\uadf8 \ud14c\ub9c8 \uc124\uce58\ubd80\ud130 \ud074\ub85c\ub4dc \ucd5c\uc801\ud654\uae4c\uc9c0: \uc81c\ud2b8\ud14c\ub9c8 \uc9c1\uc811 \uace0\uce5c \uacfc\uc815",
    "\ud074\ub85c\ub4dc \uc694\uae08\uc81c \ubb34\ub8cc\ub85c \ucda9\ubd84\ud560\uae4c? Pro\u00b7Max \uacb0\uc81c \uc804 \uc810\uac80 (\ud074\ub85c\ub4dc \uac00\uaca9\u00b7\uad6c\ub3c5\ub8cc)",
