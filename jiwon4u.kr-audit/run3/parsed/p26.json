  "schema": [
    {
      "@type": "BlogPosting",
      "headline": "\ub85c\uceec LLM \ucf54\ub529 \uc2e4\ud328\uae30: 9B \ubaa8\ub378\uc5d0 \ube14\ub85c\uadf8 \uc790\ub3d9\ud654 \ud504\ub85c\uadf8\ub7a8\uc744 \ud1b5\uc9f8\ub85c \ub9e1\uacbc\ub354\ub2c8",
      "description": "\ub85c\uceec LLM \ucf54\ub529\uc73c\ub85c \ube14\ub85c\uadf8 \uc790\ub3d9\ud654 \ud504\ub85c\uadf8\ub7a8\uc744 \ud1b5\uc9f8\ub85c \ub9cc\ub4e4\uac8c \ud588\ub354\ub2c8 \uc2e4\ud589 \ubd88\uac00\uc600\uc5b4\uc694. Qwen3.5 9B 4bit\uc5d0 \uc124\uacc4 \ubb38\uc11c\ub97c \ud1b5\uc9f8\ub85c \ub9e1\uae34 \uacb0\uacfc, \ucf54\ub4dc\uac00 \uc5b4\ub514\uc11c \uc5b4\uae0b\ub0ac\ub294\uc9c0\uc640 \uc5ed\ud560\uc744 \uc5b4\ub5bb\uac8c \ub2e4\uc2dc \ub098\ub234\ub294\uc9c0 \uc815\ub9ac\ud588\uc5b4\uc694.",
      "keywords": "\ub85c\uceecLLM, \ube14\ub85c\uadf8\uc790\ub3d9\ud654, \ud074\ub85c\ub4dc",
      "datePublished": "2026-09-30T22:34:27+09:00",
      "dateModified": "2026-10-18T21:13:27+09:00",
      "author": {
        "@type": "Organization",
