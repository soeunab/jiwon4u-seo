    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "AI\uc5d0\uc11c MCP \ub73b\uc740 \ubb34\uc5c7\uc778\uac00\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "AI\uac00 \uc678\ubd80 \ub3c4\uad6c\ub098 \ub370\uc774\ud130\uc640 \uc5f0\uacb0\ub418\ub294 \ubc29\uc2dd\uc744 \ud558\ub098\ub85c \ub9de\ucd98 \uaddc\uce59\uc778 Model Context Protocol\uc758 \uc904\uc784\ub9d0\uc774\uc5d0\uc694. \ud074\ub85c\ub4dc\uc5d0\uc11c \uc571\uc744 \uc5f0\uacb0\ud558\ub294 \uae30\ub2a5\uc774 \uc774 \ubc29\uc2dd\uc744 \uc368\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "API\uc640 API \ud0a4\ub294 \uc5b4\ub5bb\uac8c \ub2e4\ub978\uac00\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "API\ub294 \ud504\ub85c\uadf8\ub7a8\uc774 \uc11c\ube44\uc2a4\uc758 \uae30\ub2a5\uc744 \ubd80\ub974\ub294 \ud1b5\ub85c\uc774\uace0, API \ud0a4\ub294 \uadf8 \ud1b5\ub85c\ub97c \uc4f8 \uc218 \uc788\uac8c \ud574 \uc8fc\ub294 \ube44\ubc00 \ubb38\uc790\uc5f4\uc774\uc5d0\uc694. \ud0a4\uac00 \ub0a8\uc5d0\uac8c \ubcf4\uc774\uba74 \ub0b4 \uc694\uae08\uc73c\ub85c \uc4f0\uc77c \uc218 \uc788\uc5b4\uc11c \uc800\uc7a5\uc18c\ub098 \uae00\uc5d0 \uc62c\ub9ac\uc9c0 \uc54a\uc544\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "\ud1a0\ud070\uc740 \uae00\uc790 \uc218\uc640 \uac19\uc740\uac00\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\uac19\uc9c0 \uc54a\uc544\uc694. \uac19\uc740 \uae00\uc774\uc5b4\ub3c4 \ubaa8\ub378\uacfc \uc5b8\uc5b4\uc5d0 \ub530\ub77c \ud1a0\ud070 \uc218\uac00 \ub2ec\ub77c\uc694. \uc694\uae08\uacfc \ud55c\ub3c4 \uacc4\uc0b0\uc740 \uc0ac\uc6a9\ud558\ub294 \uc11c\ube44\uc2a4\uc758 \uacf5\uc2dd \uc548\ub0b4\ub97c \uae30\uc900\uc73c\ub85c \ud558\uc138\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "CLI\uc640 \uc77c\ubc18 \uc571 \ud654\uba74\uc740 \ubb34\uc5c7\uc774 \ub2e4\ub978\uac00\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\uc77c\ubc18 \uc571\uc740 \ubc84\ud2bc\uc744 \ub20c\ub7ec \uc4f0\uace0, CLI\ub294 \ud130\ubbf8\ub110\uc5d0 \uae00\uc790 \uba85\ub839\uc744 \uc785\ub825\ud574\uc11c \uc368\uc694. Claude Code\ucc98\ub7fc \ud504\ub85c\uadf8\ub7a8\uc774 \uc9c1\uc811 \ud638\ucd9c\ud560 \uc218 \uc788\ub2e4\ub294 \uc810\uc774 CLI \ubc29\uc2dd\uc758 \uc7a5\uc810\uc774\uc5d0\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "\ub85c\uceec LLM\uc774 \ud074\ub77c\uc6b0\ub4dc AI\ubcf4\ub2e4 \uc88b\uc740\uac00\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\ubaa9\uc801\uc5d0 \ub530\ub77c \ub2ec\ub77c\uc694. \uc800\ub294 \ub85c\uceec \ubaa8\ub378\uc744 \uc9e7\uace0 \uac80\uc0c9\uc774 \ud544\uc694 \uc5c6\ub294 \uac00\ubcbc\uc6b4 \uc77c\uc5d0\ub9cc \uc4f0\uace0, \uc6d0\uace0 \ubcf8\ubb38\uacfc \uc0ac\uc2e4 \uac80\uc218\ub294 Claude\uc5d0 \ub9e1\uaca8\uc694."
          }
        }
      ]
    }
  ],
