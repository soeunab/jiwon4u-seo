      },
      "publisher": {
        "@type": "Organization",
        "name": "\uc9c0\uc6d0\ud3ec\uc720"
      },
      "image": "https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEjVPBvT6RZGKmQzf4j18ZfAf7nlYRT8dvkAZpqpWdMt78ALQQSTzlJsBI26q1jToLLCZOF8Z3f3sMNXS4xKnVrEHa_YT0uolF0ElcTk-gAYrAArHLD2flBmKLsqDMotF7zmYdqnjRzgqPNOy3uDRv5B-W7VabdOxO37q5Ave3MDMiUD5suXcypTZo3PWFE/s1200/claude-mcp-ai-glossary-thumbnail.webp",
