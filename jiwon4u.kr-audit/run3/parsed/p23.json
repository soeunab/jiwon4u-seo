      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "\ub871\ud14c\uc77c \ud0a4\uc6cc\ub4dc\uac00 \ubb54\uac00\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\uac80\uc0c9\ud558\ub294 \uc0ac\ub78c\uc740 \uc788\uc9c0\ub9cc \uacbd\uc7c1\uc774 \ub35c\ud55c, \uae38\uace0 \uad6c\uccb4\uc801\uc778 \uac80\uc0c9\uc5b4\uc608\uc694. \u201c\ube14\ub85c\uadf8 \uc790\ub3d9\ud654\u201d\ubcf4\ub2e4 \u201c\ud074\ub85c\ub4dc \ube14\ub85c\uadf8 \uc790\ub3d9\ud654 \ud6c4\uae30\u201d\ucc98\ub7fc \uad6c\uccb4\uc801\uc778 \ub9d0\uc774 \ub871\ud14c\uc77c\uc5d0 \uac00\uae4c\uc6cc\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "\uc65c \uacbd\uc7c1\uc774 \uc2ec\ud55c \ud0a4\uc6cc\ub4dc\uac00 \ub300\ud45c\ub85c \ubf51\ud614\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\ud6c4\ubcf4 \ud0a4\uc6cc\ub4dc\ub97c \ube44\uad50\ud574 \ub300\ud45c\ub97c \uace0\ub974\ub294 \uae30\uc900\uc774 \uac70\uafb8\ub85c \ub418\uc5b4 \uc788\uc5c8\uc5b4\uc694. \uc2e4\uacc4\uc815\uc73c\ub85c \ub3cc\ub824 \ubcf4\uace0\uc11c\uc57c \ubc1c\uacac\ud588\uace0, \uac80\uc0c9\ub7c9\u00b7\ubb38\uc11c \uc218\u00b7\uacbd\uc7c1\ub3c4\ub97c \ud568\uaed8 \ubcf4\ub294 \ubc29\uc2dd\uc73c\ub85c \ub2e4\uc2dc \uc124\uacc4\ud588\uc5b4\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "\ube0c\ub79c\ub4dc \ubb38\uad6c\uac00 \ub2e4\ub978 \uacc4\uc815 \uae00\uc5d0 \ubd99\ub294 \uac78 \uc5b4\ub5bb\uac8c \ub9c9\uc558\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\ube0c\ub79c\ub4dc \ubb38\uad6c\ub97c \ucf54\ub4dc\uc5d0 \uace0\uc815\ud558\uc9c0 \uc54a\uace0 \uacc4\uc815\ubcc4 \uc815\ubcf4\ub97c \ub530\ub974\uac8c \ud588\uc5b4\uc694. \ub610 \uc6d0\uace0\ub97c \uc2b9\uc778\ud558\uae30 \uc804\uc5d0 \uacc4\uc815 \ucf58\uc149\ud2b8\uac00 \ube44\uc5b4 \uc788\uc73c\uba74 \uacbd\uace0\ud574\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "\ub124\uc774\ubc84 \ubc1c\ud589\uc740 \uacf5\uac1c\ub85c \ud14c\uc2a4\ud2b8\ud558\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\uc544\ub2c8\uc694. \ub124\uc774\ubc84\ub294 \uace0\uce5c \ub4a4 \ubc18\ub4dc\uc2dc \ube44\uacf5\uac1c \ubc1c\ud589\uc73c\ub85c\ub9cc \uc2dc\ud5d8\ud558\uace0, \uacf5\uac1c \ubc1c\ud589\uc73c\ub85c \uc2dc\ud5d8\ud558\uc9c0 \uc54a\uc544\uc694."
          }
        },
        {
          "@type": "Question",
          "name": "AI\uac00 \ub9cc\ub4e0 \ubc84\uadf8\ub97c AI\uac00 \uace0\uce5c \uac78 \ubbff\uc5b4\ub3c4 \ub418\ub098\uc694?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\uadf8\ub798\uc11c \u201c\uace0\ucce4\ub2e4\u201d\ub294 \ub9d0\uc740 \uc2e4\uc81c \ubc1c\ud589\uacfc \uac80\uc218\uae4c\uc9c0 \ub3cc\ub9ac\uace0, \ud654\uba74\uc5d0 \ubcf4\uc774\ub294 \uac12\uc73c\ub85c \ud655\uc778\ud558\uae30 \uc804\uc5d0\ub294 \ud558\uc9c0 \uc54a\uc544\uc694. \uacf5\uac1c \uc804\ud658\ub3c4 \ud56d\uc0c1 \uc0ac\ub78c\uc774 \ud655\uc778\ud55c \ub4a4\uc5d0\ub9cc \ub3fc\uc694."
          }
        }
      ]
    }
  ],
